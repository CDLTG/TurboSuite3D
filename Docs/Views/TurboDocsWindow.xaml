<Window
    x:Class="TurboSuite.Docs.Views.TurboDocsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:TurboSuite.Docs.Views"
    Title="TurboDocs"
    Height="750" Width="750"
    MinHeight="400" MinWidth="550"
    WindowStartupLocation="CenterScreen"
    FontFamily="Segoe UI" FontSize="11"
    KeyDown="Window_KeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TurboSuite;component/Shared/Styles/TurboSuiteStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <!-- Header bar -->
        <Border DockPanel.Dock="Top" Background="{StaticResource HeaderBlueBrush}" Padding="15,10">
            <TextBlock Text="TurboDocs - Document Generator" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
        </Border>

        <!-- Footer buttons -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource FooterBgBrush}" Padding="12,8"
                BorderBrush="#CCCCCC" BorderThickness="0,1,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Generate" Command="{Binding GenerateCommand}" Width="90" Height="28" Margin="0,0,8,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSettingsVisible}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Close" Click="CloseButton_Click" Width="70" Height="28"
                            Style="{StaticResource RevitButtonStyle}"/>
                </StackPanel>
                <Button DockPanel.Dock="Left" Command="{Binding ToggleSettingsCommand}"
                        Content="Settings" Width="78" Height="28">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource RevitButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSettingsVisible}" Value="True">
                                    <Setter Property="Background" Value="#DDEAF6"/>
                                    <Setter Property="BorderBrush" Value="#9BBDDC"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <!-- Status text -->
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="12,0,12,0"
                           TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                    <Setter Property="Foreground" Value="#B22222"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DockPanel>
        </Border>

        <!-- Content area -->
        <Grid Margin="16,12,16,6">
            <!-- Settings panel (shown when gear is toggled) -->
            <local:SettingsTab Margin="0,0,0,0"
                               Visibility="{Binding IsSettingsVisible, Converter={StaticResource BoolToVis}}"/>

            <!-- Tab content (hidden when settings is visible) -->
            <TabControl SelectedIndex="{Binding SelectedTabIndex}">
                <TabControl.Style>
                    <Style TargetType="TabControl">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSettingsVisible}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TabControl.Style>
                <TabItem Header="  Fixture Schedule  ">
                    <local:ScheduleTab DataContext="{Binding ScheduleVM}"/>
                </TabItem>
                <TabItem Header="  Cut Sheets  ">
                    <local:CutSheetsTab DataContext="{Binding CutSheetsVM}"/>
                </TabItem>
                <TabItem Header="  Load Schedule  ">
                    <local:LoadsTab DataContext="{Binding LoadsVM}"/>
                </TabItem>
                <TabItem Header="  Panel Schedule  ">
                    <local:PanelScheduleTab DataContext="{Binding PanelScheduleVM}"/>
                </TabItem>
                <TabItem Header="  Package  ">
                    <local:NotesTab DataContext="{Binding NotesVM}"/>
                </TabItem>
            </TabControl>

        </Grid>
    </DockPanel>
</Window>
