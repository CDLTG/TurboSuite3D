<Window
    x:Class="TurboSuite.Docs.Views.TurboDocsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:TurboSuite.Docs.Views"
    Title="TurboDocs"
    Height="750" Width="750"
    MinHeight="400" MinWidth="550"
    WindowStartupLocation="CenterScreen"
    FontFamily="Segoe UI" FontSize="11"
    KeyDown="Window_KeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TurboSuite;component/Shared/Styles/TurboSuiteStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <!-- Header bar -->
        <Border DockPanel.Dock="Top" Background="{StaticResource HeaderBlueBrush}" Padding="15,10">
            <TextBlock Text="TurboDocs" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
        </Border>

        <!-- Footer buttons -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource FooterBgBrush}" Padding="12,8"
                BorderBrush="#CCCCCC" BorderThickness="0,1,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Generate" Command="{Binding GenerateCommand}" Width="90" Height="28" Margin="0,0,8,0"
                            Style="{StaticResource PrimaryButtonStyle}">
                        <Button.Visibility>
                            <Binding Path="SelectedTabIndex">
                                <Binding.Converter>
                                    <local:NonZeroToVisibilityConverter/>
                                </Binding.Converter>
                            </Binding>
                        </Button.Visibility>
                    </Button>
                    <Button Content="Close" Click="CloseButton_Click" Width="70" Height="28"
                            Style="{StaticResource RevitButtonStyle}"/>
                </StackPanel>
                <!-- Status text -->
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="4,0,12,0"
                           TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <!-- Tab content -->
        <TabControl SelectedIndex="{Binding SelectedTabIndex}" Margin="16,12,16,0" Cursor="Hand">
            <TabItem Header="  Settings  ">
                <local:SettingsTab/>
            </TabItem>
            <TabItem Header="  Schedule  ">
                <local:ScheduleTab DataContext="{Binding ScheduleVM}"/>
            </TabItem>
            <TabItem Header="  Cut Sheets  ">
                <local:CutSheetsTab DataContext="{Binding CutSheetsVM}"/>
            </TabItem>
            <TabItem Header="  Load Schedule  ">
                <local:LoadsTab DataContext="{Binding LoadsVM}"/>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
