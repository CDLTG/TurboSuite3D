<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;net8.0-windows</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>TurboSuite</RootNamespace>
    <AssemblyName>TurboSuite.Core</AssemblyName>
    <Company>CDLTG</Company>
    <Authors>CDLTG</Authors>
    <Product>TurboSuite</Product>
    <Version>1.1.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="PdfSharpCore" Version="1.3.67" />
    <!-- Pin System.Memory to resolve a netstandard2.0 transitive downgrade in
         ClosedXML's graph (System.IO.Packaging wants 4.5.5; ClosedXML pulls 4.5.4).
         Not needed on net8 (built-in); harmless there and required on net48. -->
    <PackageReference Include="System.Memory" Version="4.5.5" />
  </ItemGroup>
  <!-- net48 splits System.IO.Compression{,.FileSystem} into separate GAC assemblies
       that the SDK does not auto-reference (netstandard2.0 bundled them). The Counts
       workbook post-processing uses ZipArchive + ZipFile.Open for .xlsx header/footer
       patching. net8 has these in-box, so the reference is net48-only. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <!-- System.Text.Json is in-box on net8 (shared framework) but absent from the net48
         BCL, where DocsSettingsService needs it. net48-only on purpose: the net8 build
         (the shipping Revit 2025 artifact) keeps using its built-in copy, so this package
         and its transitive graph never enter the production dependency closure. Version
         tracks the net8 in-box System.Text.Json so both TFMs serialize identically. -->
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Abstractions\TurboSuite.Abstractions.csproj" />
  </ItemGroup>
</Project>
