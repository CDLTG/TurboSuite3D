<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>TurboSuite</RootNamespace>
    <AssemblyName>TurboSuite.Core</AssemblyName>
    <Company>CDLTG</Company>
    <Authors>CDLTG</Authors>
    <Product>TurboSuite</Product>
    <Version>1.1.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="PdfSharpCore" Version="1.3.67" />
    <!-- Pin System.Memory to resolve a netstandard2.0 transitive downgrade in
         ClosedXML's graph (System.IO.Packaging wants 4.5.5; ClosedXML pulls 4.5.4).
         Not needed on net8 (built-in); harmless there and required on net48. -->
    <PackageReference Include="System.Memory" Version="4.5.5" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Abstractions\TurboSuite.Abstractions.csproj" />
  </ItemGroup>
</Project>
