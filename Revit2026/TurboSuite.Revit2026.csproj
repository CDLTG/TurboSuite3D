<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms> <!-- native ColorDialog for the TurboName Line Graphics flyout -->
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>TurboSuite</RootNamespace>
    <AssemblyName>TurboSuite</AssemblyName>
    <Company>CDLTG</Company>
    <Authors>CDLTG</Authors>
    <Product>TurboSuite</Product>
    <Version>1.4.3</Version>
    <MSBuildWarningsAsMessages>MSB3277</MSBuildWarningsAsMessages>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- Updater/Installer/Abstractions/Core now live at the repo root (one level up),
         outside this project's compile cone, so no DefaultItemExcludes are needed. -->
  </PropertyGroup>
  <!-- UseWindowsForms (for the native ColorDialog) injects System.Drawing + System.Windows.Forms as global
       usings, which collide with Autodesk.Revit.DB / System.Windows types (View, Color, KeyEventArgs, …) repo-
       wide. WinForms is used only in one file (LineGraphicsDialog), fully qualified, so drop those globals. -->
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ACadSharp" Version="3.7.1" />
    <!-- ClosedXML — see note in Core/TurboSuite.Core.csproj (0.105.0's formula
         parser is satisfied by the LET-rewritten Counts formulas). -->
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="PDFsharp" Version="6.2.4" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>C:\Program Files\Autodesk\Revit 2026\RevitAPI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>C:\Program Files\Autodesk\Revit 2026\RevitAPIUI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Xceed.Wpf.AvalonDock">
      <HintPath>C:\Program Files\Autodesk\Revit 2026\Xceed.Wpf.AvalonDock.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <!-- Shared shim source (all Revit-coupled command code + XAML + Icons), compiled
       identically into every per-version shim. Single source of truth in Shim/. -->
  <Import Project="..\Shim\Shim.projitems" Label="Shared" />
  <ItemGroup>
    <ProjectReference Include="..\Abstractions\TurboSuite.Abstractions.csproj" />
    <ProjectReference Include="..\Core\TurboSuite.Core.csproj" />
    <ProjectReference Include="..\Updater\TurboSuiteUpdater.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
    <ProjectReference Include="..\Installer\TurboSuiteInstaller.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>
  <!-- Dev inner-loop deploy. Skipped during publish (-p:SkipRevitDeploy=true) so a
       publish build never depends on the Revit addins folder being unlocked. -->
  <Target Name="CopyToRevitAddins" AfterTargets="Build" Condition="'$(SkipRevitDeploy)' != 'true'">
    <PropertyGroup>
      <RevitAddinsFolder>$(APPDATA)\Autodesk\Revit\Addins\2026</RevitAddinsFolder>
      <!-- Per-version local state — must match UpdateConstants.LocalBaseDir
           (%LOCALAPPDATA%\TurboSuite\{RevitVersion}\) so the running DLL finds the updater. -->
      <TurboSuiteLocalAppData>$(LOCALAPPDATA)\TurboSuite\2026</TurboSuiteLocalAppData>
    </PropertyGroup>
    <Copy SourceFiles="$(ProjectDir)TurboSuite.addin" DestinationFolder="$(RevitAddinsFolder)" />
    <ItemGroup>
      <OutputDlls Include="$(TargetDir)*.dll" Exclude="$(TargetDir)RevitAPI.dll;$(TargetDir)RevitAPIUI.dll" />
      <OutputPdbs Include="$(TargetDir)*.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(OutputDlls)" DestinationFolder="$(RevitAddinsFolder)\TurboSuite\" />
    <Copy SourceFiles="@(OutputPdbs)" DestinationFolder="$(RevitAddinsFolder)\TurboSuite\" />
    <!-- Copy updater files to %LOCALAPPDATA%\TurboSuite\ -->
    <MakeDir Directories="$(TurboSuiteLocalAppData)" />
    <ItemGroup>
      <UpdaterFiles Include="$(ProjectDir)..\Updater\bin\$(Configuration)\net10.0-windows\TurboSuiteUpdater.exe;
                             $(ProjectDir)..\Updater\bin\$(Configuration)\net10.0-windows\TurboSuiteUpdater.dll;
                             $(ProjectDir)..\Updater\bin\$(Configuration)\net10.0-windows\TurboSuiteUpdater.runtimeconfig.json" />
    </ItemGroup>
    <Copy SourceFiles="@(UpdaterFiles)" DestinationFolder="$(TurboSuiteLocalAppData)" SkipUnchangedFiles="false" />
  </Target>
</Project>
