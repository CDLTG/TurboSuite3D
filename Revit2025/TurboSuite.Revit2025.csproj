<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>TurboSuite</RootNamespace>
    <AssemblyName>TurboSuite</AssemblyName>
    <Company>CDLTG</Company>
    <Authors>CDLTG</Authors>
    <Product>TurboSuite</Product>
    <Version>1.2.0</Version>
    <MSBuildWarningsAsMessages>MSB3277</MSBuildWarningsAsMessages>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- Updater/Installer/Abstractions/Core now live at the repo root (one level up),
         outside this project's compile cone, so no DefaultItemExcludes are needed. -->
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ACadSharp" Version="3.4.24" />
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="PdfSharpCore" Version="1.3.67" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>C:\Program Files\Autodesk\Revit 2025\RevitAPI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>C:\Program Files\Autodesk\Revit 2025\RevitAPIUI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Xceed.Wpf.AvalonDock">
      <HintPath>C:\Program Files\Autodesk\Revit 2025\Xceed.Wpf.AvalonDock.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <!-- Shared shim source (all Revit-coupled command code + XAML + Icons), compiled
       identically into every per-version shim. Single source of truth in Shim/. -->
  <Import Project="..\Shim\Shim.projitems" Label="Shared" />
  <ItemGroup>
    <ProjectReference Include="..\Abstractions\TurboSuite.Abstractions.csproj" />
    <ProjectReference Include="..\Core\TurboSuite.Core.csproj" />
    <ProjectReference Include="..\Updater\TurboSuiteUpdater.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
    <ProjectReference Include="..\Installer\TurboSuiteInstaller.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>
  <Target Name="CopyToRevitAddins" AfterTargets="Build">
    <PropertyGroup>
      <RevitAddinsFolder>$(APPDATA)\Autodesk\Revit\Addins\2025</RevitAddinsFolder>
      <!-- Per-version local state — must match UpdateConstants.LocalBaseDir
           (%LOCALAPPDATA%\TurboSuite\{RevitVersion}\) so the running DLL finds the updater. -->
      <TurboSuiteLocalAppData>$(LOCALAPPDATA)\TurboSuite\2025</TurboSuiteLocalAppData>
    </PropertyGroup>
    <Copy SourceFiles="$(ProjectDir)TurboSuite.addin" DestinationFolder="$(RevitAddinsFolder)" />
    <ItemGroup>
      <OutputDlls Include="$(TargetDir)*.dll" Exclude="$(TargetDir)RevitAPI.dll;$(TargetDir)RevitAPIUI.dll" />
      <OutputPdbs Include="$(TargetDir)*.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(OutputDlls)" DestinationFolder="$(RevitAddinsFolder)\TurboSuite\" />
    <Copy SourceFiles="@(OutputPdbs)" DestinationFolder="$(RevitAddinsFolder)\TurboSuite\" />
    <!-- Copy updater files to %LOCALAPPDATA%\TurboSuite\ -->
    <MakeDir Directories="$(TurboSuiteLocalAppData)" />
    <ItemGroup>
      <UpdaterFiles Include="$(ProjectDir)..\Updater\bin\$(Configuration)\net8.0-windows\TurboSuiteUpdater.exe;
                             $(ProjectDir)..\Updater\bin\$(Configuration)\net8.0-windows\TurboSuiteUpdater.dll;
                             $(ProjectDir)..\Updater\bin\$(Configuration)\net8.0-windows\TurboSuiteUpdater.runtimeconfig.json" />
    </ItemGroup>
    <Copy SourceFiles="@(UpdaterFiles)" DestinationFolder="$(TurboSuiteLocalAppData)" SkipUnchangedFiles="false" />
  </Target>
</Project>
