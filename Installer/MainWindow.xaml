<Window x:Class="TurboSuiteInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TurboSuite Installer"
        Height="320" Width="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FontFamily="Segoe UI" FontSize="11">

    <Window.Resources>
        <SolidColorBrush x:Key="HeaderBlueBrush" Color="#2B579A"/>
        <SolidColorBrush x:Key="FooterBgBrush" Color="#F0F0F0"/>
        <SolidColorBrush x:Key="ButtonBgBrush" Color="#F0F0F0"/>
        <SolidColorBrush x:Key="ButtonBorderBrush" Color="#ACACAC"/>

        <Style x:Key="RevitButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ButtonBgBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ButtonBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#DCECFC"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#7EB4EA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#C4E0FC"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#569DE5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#F5F5F5"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#D9D9D9"/>
                                <Setter Property="Foreground" Value="#AAAAAA"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="{StaticResource HeaderBlueBrush}" Padding="15,10">
            <TextBlock Text="TurboSuite Installer" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
        </Border>

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource FooterBgBrush}"
                BorderBrush="#CCCCCC" BorderThickness="0,1,0,0" Padding="12,8">
            <Grid>
                <Button Content="Uninstall" HorizontalAlignment="Left"
                        Command="{Binding UninstallCommand}"
                        Style="{StaticResource RevitButtonStyle}"
                        Padding="12,5" MinWidth="75"/>
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Content="Install" Command="{Binding InstallCommand}"
                            Style="{StaticResource RevitButtonStyle}"
                            Padding="12,5" MinWidth="75" Margin="0,0,8,0"/>
                    <Button Content="Close" Command="{Binding CloseCommand}"
                            Style="{StaticResource RevitButtonStyle}"
                            Padding="12,5" MinWidth="75"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content -->
        <StackPanel Margin="16,16,16,8" VerticalAlignment="Top">
            <TextBlock Text="{Binding VersionText}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBlock Text="{Binding SourcePathText}" Foreground="#666666" FontSize="10"
                       TextTrimming="CharacterEllipsis" Margin="0,0,0,16"/>

            <ProgressBar Value="{Binding ProgressValue}" Maximum="100" Height="20" Margin="0,0,0,12"/>

            <TextBlock Text="{Binding StatusText}" Foreground="#333333" Margin="0,0,0,8"
                       TextWrapping="Wrap"/>
            <TextBlock Text="{Binding ResultText}" FontWeight="SemiBold" FontSize="12"
                       Foreground="{Binding ResultColor}" TextWrapping="Wrap"/>
        </StackPanel>
    </DockPanel>
</Window>
