<UserControl
    x:Class="TurboSuite.Docs.Views.NotesTab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    FontFamily="Segoe UI" FontSize="11">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TurboSuite;component/Shared/Styles/TurboSuiteStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel Margin="0,8">
        <!-- Package toggle -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,8,0,8">
            <TextBlock Text="Package:" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <RadioButton Content="Fixture Package" GroupName="PackageType"
                         IsChecked="{Binding IsFixturePackage}"
                         Margin="0,0,20,0" VerticalContentAlignment="Center"/>
            <RadioButton Content="Control Package" GroupName="PackageType"
                         IsChecked="{Binding IsControlPackage}"
                         VerticalContentAlignment="Center"/>
        </StackPanel>

        <!-- General Notes (Fixture Package) -->
        <GroupBox Header="General Notes"
                  Visibility="{Binding IsFixturePackage, Converter={StaticResource BoolToVis}}"
                  Margin="6,0,6,0" Style="{StaticResource BoldHeaderGroupBox}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{Binding GeneralSource}" FontSize="10"
                           Foreground="#888888" Margin="8,4,8,4" FontStyle="Italic"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                    <ItemsControl ItemsSource="{Binding GeneralNoteItems}" Margin="8,2,8,4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="11" FontWeight="SemiBold"
                                               VerticalAlignment="Top"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="11"
                                               TextWrapping="Wrap"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </GroupBox>

        <!-- Control Notes (Control Package) -->
        <GroupBox Header="Control Notes"
                  Visibility="{Binding IsControlPackage, Converter={StaticResource BoolToVis}}"
                  Margin="6,0,6,0" Style="{StaticResource BoldHeaderGroupBox}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{Binding ControlSource}" FontSize="10"
                           Foreground="#888888" Margin="8,4,8,4" FontStyle="Italic"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                    <ItemsControl ItemsSource="{Binding ControlNoteItems}" Margin="8,2,8,4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="11" FontWeight="SemiBold"
                                               VerticalAlignment="Top"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="11"
                                               TextWrapping="Wrap"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </GroupBox>
    </DockPanel>
</UserControl>
