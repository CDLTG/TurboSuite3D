<UserControl
    x:Class="TurboSuite.Docs.Views.BomTab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    FontFamily="Segoe UI" FontSize="11">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TurboSuite;component/Shared/Styles/TurboSuiteStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel Margin="0,8">
        <!-- Progress bar docked to bottom -->
        <ProgressBar DockPanel.Dock="Bottom" Value="{Binding Progress}" Height="18" Margin="0,4,0,0"
                     Visibility="{Binding IsGenerating, Converter={StaticResource BoolToVisibility}}"/>

        <!-- BOM summary -->
        <GroupBox Header="Bill of Materials" Margin="6,0,6,0" Style="{StaticResource BoldHeaderGroupBox}">
            <StackPanel Margin="16" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="{Binding SummaryText}" FontSize="14" TextAlignment="Center"
                           Foreground="#444444" Margin="0,0,0,8"/>
                <TextBlock Text="Generate a PDF of the control system bill of materials from TurboZones."
                           FontSize="11" TextAlignment="Center" Foreground="#888888"/>
            </StackPanel>
        </GroupBox>
    </DockPanel>
</UserControl>
