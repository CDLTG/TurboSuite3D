<UserControl
    x:Class="TurboSuite.Docs.Views.CountsTab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    FontFamily="Segoe UI" FontSize="11">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TurboSuite;component/Shared/Styles/TurboSuiteStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel Margin="0,8">
        <!-- Progress bar docked to bottom -->
        <ProgressBar DockPanel.Dock="Bottom" Value="{Binding Progress}" Height="18" Margin="0,4,0,0"
                     Visibility="{Binding IsGenerating, Converter={StaticResource BoolToVis}}"/>

        <GroupBox Header="Fixture Counts Export" Margin="6,0,6,0" Style="{StaticResource BoldHeaderGroupBox}">
            <StackPanel Margin="16" VerticalAlignment="Center" HorizontalAlignment="Center">
                <!-- Summary -->
                <TextBlock FontSize="14" TextAlignment="Center" Foreground="#444444" Margin="0,0,0,4">
                    <Run Text="{Binding TypeCount, Mode=OneWay}"/>
                    <Run Text=" fixture types,"/>
                    <Run Text="{Binding TotalFixtureCount, Mode=OneWay}"/>
                    <Run Text=" total instances"/>
                </TextBlock>

                <TextBlock Text="Export fixture quantities and catalog numbers to an Excel workbook for quotation."
                           FontSize="11" TextAlignment="Center" Foreground="#888888" Margin="0,0,0,16"/>

                <!-- Rep Directory Path -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                    <TextBlock Text="Rep Directory:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11" Width="90" TextAlignment="Right"/>
                    <TextBox Text="{Binding RepDirectoryPath, UpdateSourceTrigger=PropertyChanged}"
                             Width="290" VerticalContentAlignment="Center" Padding="4,2"/>
                    <Button Content="Browse…" Command="{Binding BrowseRepDirectoryCommand}"
                            Margin="6,0,0,0" Padding="10,2" Width="64" Cursor="Hand"/>
                </StackPanel>

                <!-- Header Image -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                    <TextBlock Text="Header Image:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11" Width="90" TextAlignment="Right"/>
                    <TextBox Text="{Binding HeaderImagePath, UpdateSourceTrigger=PropertyChanged}"
                             Width="290" VerticalContentAlignment="Center" Padding="4,2"
                             ToolTip="Optional. Embedded at center of header on Quote and Phase 1/2/3 sheets."/>
                    <Button Content="Browse…" Command="{Binding BrowseHeaderImageCommand}"
                            Margin="6,0,0,0" Padding="10,2" Width="64" Cursor="Hand"/>
                </StackPanel>

                <!-- Footer Image -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                    <TextBlock Text="Footer Image:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11" Width="90" TextAlignment="Right"/>
                    <TextBox Text="{Binding FooterImagePath, UpdateSourceTrigger=PropertyChanged}"
                             Width="290" VerticalContentAlignment="Center" Padding="4,2"
                             ToolTip="Optional. Embedded at center of footer on Quote and Phase 1/2/3 sheets, and as the bottom banner on the Cover sheet."/>
                    <Button Content="Browse…" Command="{Binding BrowseFooterImageCommand}"
                            Margin="6,0,0,0" Padding="10,2" Width="64" Cursor="Hand"/>
                </StackPanel>

                <!-- Cover Banner (vertical, top-left of Cover sheet; bottom banner reuses Footer Image) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                    <TextBlock Text="Cover Banner:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11" Width="90" TextAlignment="Right"/>
                    <TextBox Text="{Binding CoverVerticalPath, UpdateSourceTrigger=PropertyChanged}"
                             Width="290" VerticalContentAlignment="Center" Padding="4,2"
                             ToolTip="Optional PNG/JPEG. Floating banner anchored top-left on the Cover sheet. The Cover's bottom banner reuses the Footer Image above."/>
                    <Button Content="Browse…" Command="{Binding BrowseCoverVerticalCommand}"
                            Margin="6,0,0,0" Padding="10,2" Width="64" Cursor="Hand"/>
                </StackPanel>

                <!-- Notify Email -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                    <TextBlock Text="Notify Email:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11" Width="90" TextAlignment="Right"/>
                    <TextBox Text="{Binding NotifyEmail, UpdateSourceTrigger=PropertyChanged}"
                             Width="360" VerticalContentAlignment="Center" Padding="4,2"
                             ToolTip="Optional. When set, Generate/Update opens a pre-filled email draft to this address."/>
                </StackPanel>

                <!-- Export mode -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                    <RadioButton x:Name="NewExportRadio" Content="New Export" IsChecked="True"
                                 GroupName="ExportMode" Margin="0,0,16,0" VerticalContentAlignment="Center"
                                 FontSize="12" Checked="NewExportRadio_Checked"/>
                    <RadioButton Content="Update Existing" IsChecked="{Binding IsUpdateMode}"
                                 GroupName="ExportMode" VerticalContentAlignment="Center"
                                 FontSize="12"/>
                </StackPanel>

                <TextBlock FontSize="10" TextAlignment="Center" Foreground="#AAAAAA" Margin="0,4,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="Creates a new workbook with Cover, Worksheet, Quote, Changes, and Counts sheets."/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsUpdateMode}" Value="True">
                                    <Setter Property="Text" Value="Opens an existing workbook, appends a new Counts sheet, and updates the Worksheet with change tracking."/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </GroupBox>
    </DockPanel>
</UserControl>
