<Window
    x:Class="TurboSuite.Dali.Views.TurboDaliWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:TurboSuite.Dali.Views"
    Title="TurboDALI"
    Height="700" Width="920"
    MinHeight="500" MinWidth="740"
    WindowStartupLocation="CenterScreen"
    ShowInTaskbar="True"
    Topmost="False"
    ShowActivated="False"
    FontFamily="Segoe UI" FontSize="11">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TurboSuite;component/Shared/Styles/TurboSuiteStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <!-- ── Header (DMX chrome: blue bar + roll-up summary) ───────────────────────────────────── -->
        <Border DockPanel.Dock="Top" Background="{StaticResource HeaderBlueBrush}" Padding="14,9">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="TurboDALI" Foreground="White" FontSize="15" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding DaliTab.SummaryText}" Foreground="#DCE6F5" FontSize="12"
                           VerticalAlignment="Center" Margin="14,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- ── Lock banner (amber; shown only while numbering is locked) ─────────────────────────── -->
        <Border DockPanel.Dock="Top" Background="#FFF4E5" BorderBrush="#E0A94B" BorderThickness="0,0,0,1"
                Padding="14,6"
                Visibility="{Binding IsLocked, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding LockStateText}" Foreground="#8A5A00" FontWeight="SemiBold"
                       TextWrapping="Wrap"/>
        </Border>

        <!-- ── Footer bar: status + primary action ──────────────────────────────────────────────── -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource FooterBgBrush}"
                BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,1,0,0" Padding="10,7">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Close" Width="80" Height="28"
                        Margin="8,0,0,0" IsCancel="True" Click="Close_Click"/>
                <Button DockPanel.Dock="Right" Content="Write addresses ▸" Height="28" Padding="12,0"
                        FontWeight="SemiBold" Command="{Binding WriteAddressesCommand}"/>
                <Button DockPanel.Dock="Right" Content="{Binding LockButtonText}" Height="28" Width="72"
                        Margin="8,0,0,0" Command="{Binding LockCommand}"/>
                <Button DockPanel.Dock="Right" Content="Unlock" Height="28" Width="72" Margin="8,0,0,0"
                        Command="{Binding UnlockCommand}"/>
                <Button DockPanel.Dock="Right" Content="Refresh" Height="28" Width="80" Margin="8,0,8,0"
                        Command="{Binding RefreshCommand}"/>
                <TextBlock VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" Text="{Binding StatusText}"/>
            </DockPanel>
        </Border>

        <!-- ── REVIEW list (amber; shown only when the lock flags issued-address drift) ───────────── -->
        <Border DockPanel.Dock="Bottom" Margin="10,0,10,6" Padding="8,6" Background="#FFF4E5"
                BorderBrush="#E0A94B" BorderThickness="1"
                Visibility="{Binding HasReviews, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="REVIEW — issued addresses affected since lock" FontWeight="SemiBold"
                           Foreground="#8A5A00" Margin="0,0,0,3"/>
                <ItemsControl ItemsSource="{Binding Reviews}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="#8A5A00" Margin="0,1"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- ── Body ──────────────────────────────────────────────────────────────────────────────── -->
        <Grid Margin="10">
            <!-- Placeholder when the job carries no DALI fixtures -->
            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}" FontStyle="Italic"
                       TextAlignment="Center" MaxWidth="420" TextWrapping="Wrap"
                       Visibility="{Binding DaliTab.HasDaliHardware, Converter={StaticResource InverseBoolToVisibility}}"
                       Text="No DALI fixtures found. Set a fixture's Dimming Protocol to DALI and give it a Control Zone, then reopen TurboDALI to declare loops."/>

            <DockPanel Visibility="{Binding DaliTab.HasDaliHardware, Converter={StaticResource BoolToVisibility}}">
                <!-- Intro + warnings -->
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"
                               Text="Group Control Zones into DALI loops (one loop = one LQSE2-1DALUNV-D module) and assign each loop the ZONE its module is placed in. Then Write addresses to stamp each circuit's L#-## onto its fixtures and driver."/>

                    <Border Margin="0,6,0,0" Padding="8,5" Background="#FFF4E5"
                            BorderBrush="#E0A94B" BorderThickness="1"
                            Visibility="{Binding DaliTab.HasUnassignedLoops, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding DaliTab.UnassignedLoopMessage}" TextWrapping="Wrap" Foreground="#8A5A00"/>
                    </Border>
                    <Border Margin="0,6,0,0" Padding="8,5" Background="#FDE7E7"
                            BorderBrush="#D46A6A" BorderThickness="1"
                            Visibility="{Binding DaliTab.HasOverCapLoops, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding DaliTab.OverCapMessage}" TextWrapping="Wrap" Foreground="#9B2C2C"/>
                    </Border>
                </StackPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Unassigned Control Zone pool -->
                    <DockPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock DockPanel.Dock="Top" Text="Unassigned Control Zones"
                                   FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                            <Button Content="New loop from selection" Height="26"
                                    Command="{Binding DaliTab.NewLoopFromSelectionCommand}"/>
                            <Button Content="New empty loop" Height="24" Margin="0,4,0,0"
                                    Command="{Binding DaliTab.NewLoopCommand}"/>
                        </StackPanel>
                        <Border BorderThickness="1" BorderBrush="{StaticResource SeparatorBrush}" Background="#FAFAFA">
                            <ListBox ItemsSource="{Binding DaliTab.Pool}" SelectionMode="Extended"
                                     BorderThickness="0" Background="Transparent"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Display}"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </DockPanel>

                    <!-- Declared loops -->
                    <DockPanel Grid.Column="1">
                        <TextBlock DockPanel.Dock="Top" Text="DALI Loops" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding DaliTab.Loops}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,6" Padding="8" BorderThickness="1"
                                                BorderBrush="{StaticResource SeparatorBrush}" Background="#FFFFFF">
                                            <StackPanel>
                                                <!-- Row header: name, zone assignment, remove -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Grid.Column="0" Text="{Binding Name, UpdateSourceTrigger=LostFocus}"
                                                             Height="24" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                                                    <ComboBox Grid.Column="1" Width="130" Height="24"
                                                              ItemsSource="{Binding ZoneOptions}"
                                                              DisplayMemberPath="Label" SelectedValuePath="Value"
                                                              SelectedValue="{Binding AssignedZone}"/>
                                                    <Button Grid.Column="2" Content="✕ Loop" Height="24"
                                                            Margin="8,0,0,0" Padding="6,0" Command="{Binding RemoveCommand}"/>
                                                </Grid>

                                                <TextBlock Text="{Binding StatusText}" Margin="0,4,0,0"
                                                           Foreground="{StaticResource TextSecondaryBrush}"/>

                                                <!-- Member zones + add gesture -->
                                                <DockPanel Margin="0,6,0,0">
                                                    <Button DockPanel.Dock="Right" VerticalAlignment="Top"
                                                            Content="+ Add selected" Height="24" Padding="6,0"
                                                            Margin="8,0,0,0" Command="{Binding AddSelectedCommand}"/>
                                                    <ItemsControl ItemsSource="{Binding Zones}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Margin="0,0,4,4" Padding="5,2"
                                                                        Background="#EEF3FA" BorderBrush="#B0BED0"
                                                                        BorderThickness="1">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="{Binding Display}" VerticalAlignment="Center"/>
                                                                        <Button Content="✕" Margin="5,0,0,0" Padding="3,0" FontSize="9"
                                                                                Background="Transparent" BorderThickness="0"
                                                                                Command="{Binding DataContext.RemoveZoneCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                                                CommandParameter="{Binding}"/>
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </DockPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
