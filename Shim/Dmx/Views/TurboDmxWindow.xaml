<Window
    x:Class="TurboSuite.Dmx.Views.TurboDmxWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="TurboDMX"
    Height="792" Width="1220"
    MinHeight="552" MinWidth="1040"
    WindowStartupLocation="CenterScreen"
    ShowInTaskbar="True"
    Topmost="False"
    ShowActivated="False"
    FontFamily="Segoe UI" FontSize="11"
    KeyDown="Window_KeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TurboSuite;component/Shared/Styles/TurboSuiteStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="SectionHeader" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,10,0,4"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            </Style>
            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,2,8,2"/>
            </Style>
            <Style x:Key="BillNumber" TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            </Style>
            <Style x:Key="HintText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="0,0,0,4"/>
            </Style>

            <!-- Flat, chrome-less icon/text button for the demoted loop-row actions (←, + Cluster, ⊙, ✕, 🗑).
                 Keeps Place ▸ / One-line ▸ / + Add selected as the only chromed = primary buttons. -->
            <Style x:Key="IconButton" TargetType="Button">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="4,1"/>
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.4"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Shared width of every loop-row "right region" — the gutter all name-box right edges align to.
                 Repeated on the identity row, the action strip, and each cluster row; edit here only. -->
            <GridLength x:Key="LoopGutter">150</GridLength>

            <!-- Loop card = column-1 GroupBox look (Option A): the loop's Border matches the GroupBox
                 chrome — the Aero2 GroupBox border tone (#D5DFE5), white fill, and the same 10px
                 inter-card gap — but stays squared. The editable name-box is the card's header, so
                 there's no title notch. -->
            <Style x:Key="LoopCard" TargetType="Border">
                <Setter Property="BorderBrush" Value="#D5DFE5"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="3"/>
                <Setter Property="Background" Value="{StaticResource ContentBgBrush}"/>
                <Setter Property="Padding" Value="8"/>
                <Setter Property="Margin" Value="0,0,0,10"/>
            </Style>

            <!-- Dim BOM badge in the loop header ("{n} dec/drv · {ch} ch"). -->
            <Style x:Key="LoopBadge" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource FooterBgBrush}"/>
                <Setter Property="Padding" Value="6,1"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <!-- Kit GroupBox header = a flat clickable label + "▾" (the dropdown trigger for the Edit popup).
                 Lives in a GroupBox.Header slot, so it stays chrome-less and just reads as the header text. -->
            <Style x:Key="KitHeaderButton" TargetType="Button">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource ContentBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="12,10,12,6">
            <TextBlock Text="TurboDMX" FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="{Binding SummaryText}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>

            <!-- Numbering-lock banner (§8c) — amber when Locked -->
            <Border Margin="0,6,0,0" Padding="6,3">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource FooterBgBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                <Setter Property="Background" Value="#FFF3CD"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding LockStateText}" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
            </Border>
        </StackPanel>

        <!-- Body: [ settings + kits | pool | loops | bill ] — one full-height band -->
        <Grid Grid.Row="1" Margin="12,0,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>   <!-- left: settings + kits -->
                <ColumnDefinition Width="180"/>   <!-- zone pool -->
                <ColumnDefinition Width="*"/>     <!-- loops -->
                <ColumnDefinition Width="250"/>   <!-- bill -->
            </Grid.ColumnDefinitions>

            <!-- LEFT: profile + settings (stacked) + decoder / driver kits -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,8,0">
                <StackPanel>
                    <!-- Column title — matches ZONE POOL / LOOPS -->
                    <TextBlock Text="DECLARATIONS" Style="{StaticResource SectionHeader}" Margin="0,4,0,6"/>

                    <!-- General: profile + system voltage -->
                    <GroupBox Header="General" Margin="0,0,0,10" Style="{StaticResource BoldHeaderGroupBox}">
                        <StackPanel Margin="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Profile" Style="{StaticResource FieldLabel}"
                                           ToolTip="DMX control profile — sets the per-interface channel ceiling (Lutron 32, native 512)."/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                                          DisplayMemberPath="Name" HorizontalAlignment="Stretch"/>
                            </Grid>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="System" Style="{StaticResource FieldLabel}"
                                           ToolTip="LED/driver operating voltage (e.g. 24 V)."/>
                                <TextBox   Grid.Column="1" Text="{Binding SystemVolts}" Margin="0,2"
                                           ToolTip="LED/driver operating voltage (e.g. 24 V)."/>
                                <TextBlock Grid.Column="2" Text="V" VerticalAlignment="Center" Margin="6,0,0,0"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Grid>
                        </StackPanel>
                    </GroupBox>

                    <!-- Breaker packing -->
                    <GroupBox Header="Breaker packing" Margin="0,0,0,10" Style="{StaticResource BoldHeaderGroupBox}">
                        <StackPanel Margin="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Feed" Style="{StaticResource FieldLabel}"
                                           ToolTip="Branch-circuit feed voltage to the drivers (e.g. 120 V)."/>
                                <TextBox   Grid.Row="0" Grid.Column="1" Text="{Binding FeedVolts}" Margin="0,2"
                                           ToolTip="Branch-circuit feed voltage to the drivers (e.g. 120 V)."/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="V" VerticalAlignment="Center" Margin="6,0,0,0"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Breaker" Style="{StaticResource FieldLabel}"
                                           ToolTip="Branch breaker rating."/>
                                <TextBox   Grid.Row="1" Grid.Column="1" Text="{Binding BreakerAmps}" Margin="0,2"
                                           ToolTip="Branch breaker rating."/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="A" VerticalAlignment="Center" Margin="6,0,0,0"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Derate" Style="{StaticResource FieldLabel}"
                                           ToolTip="Continuous-load derate applied to breaker capacity (80% = 0.8 factor)."/>
                                <TextBox   Grid.Row="2" Grid.Column="1" Text="{Binding DeratePercent}" Margin="0,2"
                                           ToolTip="Continuous-load derate applied to breaker capacity (80% = 0.8 factor)."/>
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="%" VerticalAlignment="Center" Margin="6,0,0,0"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Grid>

                            <!-- Basis: how breakers are packed (driver rating vs actual load) -->
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Basis" Style="{StaticResource FieldLabel}" VerticalAlignment="Top"/>
                                <StackPanel Grid.Column="1" Orientation="Vertical">
                                    <RadioButton Content="Driver rating (safe)" IsChecked="{Binding PackByNameplate}"
                                                 GroupName="BreakerBasis"
                                                 ToolTip="Pack breakers by each driver's full rated wattage. Inrush-honest, so the Drivers/breaker cap is unneeded and ignored."/>
                                    <RadioButton Content="Actual load" IsChecked="{Binding PackByActualLoad}"
                                                 GroupName="BreakerBasis" Margin="0,4,0,0"
                                                 ToolTip="Pack breakers by the connected DMX-fixture wattage — the tighter count. You manage inrush by setting the Drivers/breaker cap."/>
                                </StackPanel>
                            </Grid>

                            <!-- Drivers/breaker inrush cap — actual-load only (grays out under Driver rating) -->
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Drivers/breaker" Style="{StaticResource FieldLabel}"
                                           IsEnabled="{Binding DriversPerBreakerEnabled}"
                                           ToolTip="Manual per-breaker inrush cap — applies only to actual-load packing. Driver rating ignores it."/>
                                <TextBox   Grid.Column="1" Text="{Binding MaxDriversPerBreaker}" Margin="0,2"
                                           IsEnabled="{Binding DriversPerBreakerEnabled}"
                                           ToolTip="Manual per-breaker inrush cap — applies only to actual-load packing. Driver rating ignores it."/>
                            </Grid>
                        </StackPanel>
                    </GroupBox>

                    <!-- Homerun -->
                    <GroupBox Header="Homerun" Margin="0,0,0,10" Style="{StaticResource BoldHeaderGroupBox}">
                        <StackPanel Margin="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Pull-up" Style="{StaticResource FieldLabel}"
                                           ToolTip="Bump every homerun this many stock sizes past exact (0 = exact)."/>
                                <TextBox   Grid.Column="1" Text="{Binding PullUpSizes}" Margin="0,2"
                                           ToolTip="Bump every homerun this many stock sizes past exact (0 = exact)."/>
                            </Grid>
                        </StackPanel>
                    </GroupBox>

                    <!-- Decoders — GroupBox whose header IS the ▾ dropdown trigger; content = curated table -->
                    <GroupBox Margin="0,0,0,10">
                        <GroupBox.Header>
                            <Button x:Name="DecoderEditButton" Style="{StaticResource KitHeaderButton}"
                                    Command="{Binding EditDecoderKitCommand}"
                                    ToolTip="Click to choose which decoder types are in this job's kit.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Decoders" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="▾" Margin="6,0,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Button>
                        </GroupBox.Header>
                        <StackPanel Margin="4">
                            <ItemsControl ItemsSource="{Binding SelectedDecoderRows}" AlternationCount="1000">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="2,4">
                                            <Border.Style>
                                                <!-- Divider BETWEEN rows: top border on every row but the first (index 0). -->
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="{StaticResource SeparatorBrush}"/>
                                                    <Setter Property="BorderThickness" Value="0,1,0,0"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="0">
                                                            <Setter Property="BorderThickness" Value="0"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Detail, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="No decoders selected — click the header to add."
                                       Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Padding="2,4">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AnyDecoderSelected}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </GroupBox>
                    <Popup PlacementTarget="{Binding ElementName=DecoderEditButton}" Placement="Bottom"
                           IsOpen="{Binding DecoderPickerOpen, Mode=TwoWay}" StaysOpen="False"
                           AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Background="{StaticResource ContentBgBrush}" BorderBrush="{StaticResource SeparatorBrush}"
                                BorderThickness="1" Padding="6" Width="320">
                            <StackPanel>
                                <Grid>
                                    <TextBox x:Name="DecoderSearch" Text="{Binding DecoderFilter, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="search…" Foreground="{StaticResource TextSecondaryBrush}" Margin="4,0,0,0"
                                               VerticalAlignment="Center" IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=DecoderSearch}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                                    <ItemsControl ItemsSource="{Binding DecoderPickRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected}" Margin="0,3">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Detail, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    </StackPanel>
                                                </CheckBox>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <!-- Drivers — GroupBox whose header IS the ▾ dropdown trigger; content = curated table -->
                    <GroupBox Margin="0,0,0,10">
                        <GroupBox.Header>
                            <Button x:Name="DriverEditButton" Style="{StaticResource KitHeaderButton}"
                                    Command="{Binding EditDriverKitCommand}"
                                    ToolTip="Click to choose which driver types are in this job's kit.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Drivers" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="▾" Margin="6,0,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Button>
                        </GroupBox.Header>
                        <StackPanel Margin="4">
                            <ItemsControl ItemsSource="{Binding SelectedDriverRows}" AlternationCount="1000">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="2,4">
                                            <Border.Style>
                                                <!-- Divider BETWEEN rows: top border on every row but the first (index 0). -->
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="{StaticResource SeparatorBrush}"/>
                                                    <Setter Property="BorderThickness" Value="0,1,0,0"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="0">
                                                            <Setter Property="BorderThickness" Value="0"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Detail, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="No drivers selected — click the header to add."
                                       Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Padding="2,4">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AnyDriverSelected}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </GroupBox>
                    <Popup PlacementTarget="{Binding ElementName=DriverEditButton}" Placement="Bottom"
                           IsOpen="{Binding DriverPickerOpen, Mode=TwoWay}" StaysOpen="False"
                           AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Background="{StaticResource ContentBgBrush}" BorderBrush="{StaticResource SeparatorBrush}"
                                BorderThickness="1" Padding="6" Width="320">
                            <StackPanel>
                                <Grid>
                                    <TextBox x:Name="DriverSearch" Text="{Binding DriverFilter, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="search…" Foreground="{StaticResource TextSecondaryBrush}" Margin="4,0,0,0"
                                               VerticalAlignment="Center" IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=DriverSearch}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                                    <ItemsControl ItemsSource="{Binding DriverPickRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected}" Margin="0,3">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Detail, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    </StackPanel>
                                                </CheckBox>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>
            </ScrollViewer>

            <!-- ZONE POOL (unassigned zones — the multi-select assignment source);
                 left separator mirrors the BILL column's boundary. -->
            <Border Grid.Column="1" BorderThickness="1,0,0,0" BorderBrush="{StaticResource SeparatorBrush}"
                    Padding="12,0,8,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="ZONE POOL" Style="{StaticResource SectionHeader}" Margin="0,4,0,6"/>
                <!-- One card like the left column: header tooltip carries the former hint. -->
                <GroupBox>
                    <GroupBox.Header>
                        <TextBlock Text="Zones" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"
                                   ToolTip="Unassigned zones — the engine auto-packs. Select, then '+ Add' on a loop."/>
                    </GroupBox.Header>
                    <ListBox ItemsSource="{Binding ZonePool}" SelectionMode="Extended"
                             BorderThickness="0" Background="Transparent">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Display}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </GroupBox>
            </DockPanel>
            </Border>

            <!-- LOOPS (tree: loop → zones → clusters) -->
            <DockPanel Grid.Column="2" Margin="0,0,8,0">
                <!-- Header row: title + inline transient status. Keeping the status in-line (not a
                     separate line below) puts the first loop's top on the same baseline as the
                     Zones / General cards — the header carries the top:4 / bottom:6 like the others. -->
                <Grid DockPanel.Dock="Top" Margin="0,4,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="LOOPS" Style="{StaticResource SectionHeader}" Margin="0"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding BuilderStatus}" Style="{StaticResource HintText}"
                               Margin="12,0,0,0" VerticalAlignment="Center"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                </Grid>
                <!-- Pinned at the bottom: one context-sensitive add button (seeds from the pool selection, else empty). -->
                <Button DockPanel.Dock="Bottom" Content="+ New loop" Padding="6,3" Margin="0,6,0,0"
                        Command="{Binding NewLoopCommand}"
                        ToolTip="New loop — seeded with the selected pool zones, or empty if none selected."/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Loops}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource LoopCard}">
                                    <StackPanel>
                                        <!-- Identity row: name (fills) · Reserved box · [ BOM badge · 🗑 ] gutter.
                                             Reserved sits BETWEEN the name and the shared gutter (eats the name's
                                             stretch, not the gutter). Delete-loop 🗑 is the gutter's right cell (where
                                             ⋯ used to be), so it aligns down-column with each cluster's ✕. -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="{StaticResource LoopGutter}"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Text="{Binding Name, UpdateSourceTrigger=LostFocus}"
                                                     VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0"
                                                        VerticalAlignment="Center"
                                                        ToolTip="Channels reserved on this loop's interface for smart fixtures (§3c). 0 = none. Edge case — leave 0 unless this loop has DMX-addressable fixtures the tape packer doesn't place.">
                                                <TextBlock Text="Reserved" Style="{StaticResource FieldLabel}" Margin="0,0,6,0"/>
                                                <TextBox Width="40" VerticalAlignment="Center"
                                                         Text="{Binding ReservedChannels, UpdateSourceTrigger=LostFocus}"/>
                                            </StackPanel>
                                            <Grid Grid.Column="2" Margin="8,0,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Style="{StaticResource LoopBadge}"
                                                        ToolTip="This loop's slice of the bill from the last solve — decoder/driver count and channels used.">
                                                    <TextBlock Text="{Binding Summary}" HorizontalAlignment="Center"
                                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                                </Border>
                                                <Button Grid.Column="1" Content="🗑" Margin="4,0,0,0"
                                                        Style="{StaticResource IconButton}"
                                                        Command="{Binding RemoveCommand}"
                                                        ToolTip="Delete this loop — its zones return to the pool."/>
                                            </Grid>
                                        </Grid>

                                        <!-- Action strip: + Add (left) · [ Place · One-line ] right region (same 190px gutter).
                                             Place + One-line split the region into two equal buttons. -->
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="{StaticResource LoopGutter}"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="+ Add selected" Padding="6,2" HorizontalAlignment="Left"
                                                    Command="{Binding AddSelectedCommand}"
                                                    ToolTip="Add the zones selected in the pool to this loop."/>
                                            <Grid Grid.Column="1" Margin="8,0,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Content="Place ▸" Padding="6,2" Margin="0,0,2,0"
                                                        Command="{Binding PlaceCommand}"
                                                        ToolTip="Pick a point and place this loop's decoders + drivers."/>
                                                <Button Grid.Column="1" Content="One-line ▸" Padding="6,2" Margin="2,0,0,0"
                                                        Command="{Binding DrawOneLineCommand}"
                                                        ToolTip="Draw/redraw this loop's one-line on its own Drafting View."/>
                                            </Grid>
                                        </Grid>

                                        <!-- Divider between the header and the zone list -->
                                        <Border BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,1,0,0" Margin="0,6,0,0"/>

                                        <!-- Zones in this loop -->
                                        <ItemsControl ItemsSource="{Binding Zones}" Margin="14,4,0,0" AlternationCount="1000">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <!-- Divider BETWEEN zones: top border on every row but the first
                                                         (index 0), so there's no trailing line under the last zone. -->
                                                    <Border Padding="0,2">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="BorderBrush" Value="{StaticResource SeparatorBrush}"/>
                                                                <Setter Property="BorderThickness" Value="0,1,0,0"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="0">
                                                                        <Setter Property="BorderThickness" Value="0"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel>
                                                            <!-- Zone header: ← (to pool, left) · name (N runs) · split (right) -->
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Button Grid.Column="0" Content="←" Margin="0,0,6,0"
                                                                        Style="{StaticResource IconButton}"
                                                                        Command="{Binding RemoveFromLoopCommand}"
                                                                        ToolTip="Return this zone to the pool."/>
                                                                <TextBlock Grid.Column="1" Text="{Binding Header}" VerticalAlignment="Center"
                                                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                                                <Button Grid.Column="2" Content="+ Cluster" Margin="4,0,0,0"
                                                                        Style="{StaticResource IconButton}"
                                                                        Command="{Binding NewClusterCommand}"
                                                                        Visibility="{Binding CanSplit, Converter={StaticResource BoolToVisibility}}"
                                                                        ToolTip="New cluster in this zone: select tape runs in the model, then click."/>
                                                            </Grid>

                                                            <!-- Cluster sub-builder (only when the zone spans ≥2 runs).
                                                                 Left margin indents the children (unclustered text + cluster
                                                                 name boxes) past the zone title; right stays 0 so the gutter
                                                                 (⊙/✕) is unmoved. -->
                                                            <StackPanel Margin="26,2,0,2"
                                                                        Visibility="{Binding CanSplit, Converter={StaticResource BoolToVisibility}}">
                                                                <TextBlock Text="{Binding ResidualText}" Foreground="{StaticResource TextSecondaryBrush}"
                                                                           Visibility="{Binding HasClusters, Converter={StaticResource BoolToVisibility}}"/>
                                                                <ItemsControl ItemsSource="{Binding Clusters}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <!-- name (fills to gutter) · [ runs · Select · ✕ ] same 190px right region -->
                                                                            <Grid Margin="0,1">
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="*"/>
                                                                                    <ColumnDefinition Width="{StaticResource LoopGutter}"/>
                                                                                </Grid.ColumnDefinitions>
                                                                                <TextBox Grid.Column="0" Text="{Binding Name, UpdateSourceTrigger=LostFocus}"/>
                                                                                <!-- Gutter: run count left (unmoved), ⊙ Select + ✕ remove right-anchored
                                                                                     to the gutter edge — ✕ aligns down-column with the loop 🗑. -->
                                                                                <Grid Grid.Column="1" Margin="8,0,0,0">
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="24"/>
                                                                                        <ColumnDefinition Width="*"/>
                                                                                        <ColumnDefinition Width="Auto"/>
                                                                                        <ColumnDefinition Width="Auto"/>
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <TextBlock Grid.Column="0" Text="{Binding RunCount}"
                                                                                               HorizontalAlignment="Left" VerticalAlignment="Center"
                                                                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                                    <Button Grid.Column="2" Content="⊙" Margin="0,0,2,0"
                                                                                            Style="{StaticResource IconButton}"
                                                                                            Command="{Binding VerifyCommand}"
                                                                                            ToolTip="Select this cluster's tape runs in the model."/>
                                                                                    <Button Grid.Column="3" Content="✕" Margin="0"
                                                                                            Style="{StaticResource IconButton}"
                                                                                            Command="{Binding RemoveCommand}"
                                                                                            ToolTip="Remove this cluster — its runs return to (unclustered)."/>
                                                                                </Grid>
                                                                            </Grid>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <!-- BILL (always-on whole-system roll-up) -->
            <Border Grid.Column="3" BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="1,0,0,0"
                    Padding="12,0,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="BILL" Style="{StaticResource SectionHeader}" Margin="0,4,0,6"/>

                    <Border DockPanel.Dock="Top" Margin="0,0,0,10" Padding="6"
                            Background="{StaticResource FooterBgBrush}">
                        <TextBlock Text="{Binding Bill.StatusMessage}" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Bill.IsError}" Value="True">
                                            <Setter Property="Foreground" Value="#C0392B"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Bill.HasResult}" Value="True">
                                            <Setter Property="Foreground" Value="#1E8449"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <!-- REVIEW verdicts (§8c) — amber list, shown only when Locked + a conflict exists -->
                    <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Bill.Reviews}"
                                  Visibility="{Binding Bill.NeedsReview, Converter={StaticResource BoolToVisibility}}"
                                  Margin="0,0,0,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FFF3CD" Padding="6" Margin="0,0,0,4">
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="#7A5B00"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Totals -->
                            <GroupBox Header="Totals" Margin="0,0,0,10" Style="{StaticResource BoldHeaderGroupBox}">
                                <Grid Margin="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Interfaces" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Bill.InterfaceCount}" Style="{StaticResource BillNumber}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Decoders" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Bill.Decoders}" Style="{StaticResource BillNumber}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Drivers" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Bill.Drivers}" Style="{StaticResource BillNumber}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Breakers" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Bill.Breakers}" Style="{StaticResource BillNumber}"/>
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Channels" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Bill.ChannelsText}" Style="{StaticResource BillNumber}"/>
                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Processors" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Bill.Processors}" Style="{StaticResource BillNumber}"/>
                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Repeaters" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Bill.Repeaters}" Style="{StaticResource BillNumber}"/>
                                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Total W" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Bill.TotalWattsText}" Style="{StaticResource BillNumber}"/>
                                </Grid>
                            </GroupBox>

                            <!-- Decoder BOM -->
                            <GroupBox Header="Decoder BOM" Margin="0,0,0,10" Style="{StaticResource BoldHeaderGroupBox}">
                                <ItemsControl ItemsSource="{Binding Bill.DecoderBom}" Margin="4">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Display}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </GroupBox>

                            <!-- Driver BOM -->
                            <GroupBox Header="Driver BOM" Margin="0,0,0,10" Style="{StaticResource BoldHeaderGroupBox}">
                                <ItemsControl ItemsSource="{Binding Bill.DriverBom}" Margin="4">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Display}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </GroupBox>

                            <!-- Wire legend (Phase 6): dense, per-job numbering — the same numbers the
                                 one-line stamps on each wire. Only types actually used appear. -->
                            <GroupBox Header="Wire Legend" Margin="0,0,0,10" Style="{StaticResource BoldHeaderGroupBox}">
                                <StackPanel Margin="4">
                                    <ItemsControl ItemsSource="{Binding WireLegend}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,1,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <!-- Number left-aligned at the card edge (same indent as the Driver BOM
                                                         lines), then a gap before the label. -->
                                                    <TextBlock Grid.Column="0" Text="{Binding Number}" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Label}" Margin="8,0,0,0"
                                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Content="Legend view ▸" Command="{Binding DrawWireLegendCommand}"
                                            HorizontalAlignment="Left" Margin="0,8,0,0" Padding="8,3"
                                            ToolTip="Generate (or redraw) the one per-job wire-legend drafting view you can place on a sheet — same numbers as the one-line."/>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Lifecycle bar -->
        <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{StaticResource SeparatorBrush}"
                Padding="12,8" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding PlacementStatus}" TextWrapping="Wrap"
                           VerticalAlignment="Center" Margin="0,0,12,0"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{Binding LockButtonText}" Command="{Binding LockCommand}" MinWidth="68" Padding="8,3" Margin="0,0,6,0"
                            ToolTip="Lock: snapshot the current numbering as the issued baseline (§8c) — re-runs then preserve issued DEC #s and flag conflicts as REVIEW. Press again while Locked to re-baseline (re-issue) without renumbering — confirmed."/>
                    <Button Content="Unlock" Command="{Binding UnlockCommand}" MinWidth="68" Padding="8,3" Margin="0,0,12,0"
                            ToolTip="Return to free renumbering (clobber) — confirmed."/>
                    <Button Content="Refresh" Command="{Binding RefreshCommand}" MinWidth="80" Padding="10,3"
                            ToolTip="Re-read the model (zones, fixtures, loaded decoder/driver types) and re-solve — preserving your declarations. The bill re-solves automatically whenever you change a declaration, so use this when the model itself changed."/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
