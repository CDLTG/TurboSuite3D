<Window
    x:Class="TurboSuite.Dmx.Views.TurboDmxWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="TurboDMX"
    Height="660" Width="900"
    MinHeight="460" MinWidth="720"
    WindowStartupLocation="CenterScreen"
    ShowInTaskbar="True"
    Topmost="False"
    ShowActivated="False"
    FontFamily="Segoe UI" FontSize="11"
    KeyDown="Window_KeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TurboSuite;component/Shared/Styles/TurboSuiteStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="SectionHeader" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,10,0,4"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            </Style>
            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,2,8,2"/>
            </Style>
            <Style x:Key="BillNumber" TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            </Style>
            <Style x:Key="HintText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="0,0,0,4"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource ContentBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="12,10,12,6">
            <TextBlock Text="TurboDMX" FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="{Binding SummaryText}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>

            <!-- Numbering-lock banner (§8c) — amber when Locked -->
            <Border Margin="0,6,0,0" Padding="6,3">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource FooterBgBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                <Setter Property="Background" Value="#FFF3CD"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding LockStateText}" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
            </Border>
        </StackPanel>

        <!-- Body: declarations (collapsible) over [ pool | loops | bill ] -->
        <Grid Grid.Row="1" Margin="12,0,12,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- DECLARATIONS (set once, then collapse to focus on loops) -->
            <Expander Grid.Row="0" Header="Declarations" IsExpanded="True" Margin="0,0,0,6"
                      Foreground="{StaticResource TextPrimaryBrush}">
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto" MinWidth="150"/>
                        <ColumnDefinition Width="Auto" MinWidth="150"/>
                    </Grid.ColumnDefinitions>

                    <!-- Profile + settings -->
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Profile" Style="{StaticResource FieldLabel}"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                                      DisplayMemberPath="Name" HorizontalAlignment="Left" Width="140"/>
                        </Grid>

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="System V" Style="{StaticResource FieldLabel}"/>
                            <TextBox   Grid.Row="0" Grid.Column="1" Text="{Binding SystemVolts}"/>
                            <TextBlock Grid.Row="0" Grid.Column="3" Text="Breaker A" Style="{StaticResource FieldLabel}"/>
                            <TextBox   Grid.Row="0" Grid.Column="4" Text="{Binding BreakerAmps}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Feed V" Style="{StaticResource FieldLabel}"/>
                            <TextBox   Grid.Row="1" Grid.Column="1" Text="{Binding FeedVolts}"/>
                            <TextBlock Grid.Row="1" Grid.Column="3" Text="Derate" Style="{StaticResource FieldLabel}"/>
                            <TextBox   Grid.Row="1" Grid.Column="4" Text="{Binding BreakerContinuousDerate}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Drv/brkr" Style="{StaticResource FieldLabel}"
                                       IsEnabled="{Binding DriversPerBreakerEnabled}"
                                       ToolTip="Manual per-breaker inrush cap — applies only to actual-load packing. Nameplate ignores it."/>
                            <TextBox   Grid.Row="2" Grid.Column="1" Text="{Binding MaxDriversPerBreaker}"
                                       IsEnabled="{Binding DriversPerBreakerEnabled}"
                                       ToolTip="Manual per-breaker inrush cap — applies only to actual-load packing. Nameplate ignores it."/>

                            <TextBlock Grid.Row="3" Grid.Column="3" Text="Pull-up" Style="{StaticResource FieldLabel}"
                                       ToolTip="Bump every #16-N homerun this many stock sizes past exact (0 = exact)."/>
                            <TextBox   Grid.Row="3" Grid.Column="4" Text="{Binding PullUpSizes}"
                                       ToolTip="Bump every #16-N homerun this many stock sizes past exact (0 = exact)."/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Packing" Style="{StaticResource FieldLabel}"/>
                            <StackPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="0,4,0,0">
                                <RadioButton Content="Nameplate (safe)" IsChecked="{Binding PackByNameplate}"
                                             GroupName="BreakerBasis" VerticalAlignment="Center"
                                             ToolTip="Pack breakers by each driver's full rated wattage. Inrush-honest, so the Drv/brkr cap is unneeded and ignored."/>
                                <RadioButton Content="Actual load" IsChecked="{Binding PackByActualLoad}"
                                             GroupName="BreakerBasis" VerticalAlignment="Center" Margin="14,0,0,0"
                                             ToolTip="Pack breakers by the connected DMX-fixture wattage — the tighter count. You manage inrush by setting the Drv/brkr cap."/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Decoders -->
                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                        <TextBlock Text="Decoders" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                        <ItemsControl ItemsSource="{Binding DecoderRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected}" Margin="0,1">
                                        <TextBlock>
                                            <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/>
                                            <Run Text="  "/>
                                            <Run Text="{Binding Detail, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </TextBlock>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Drivers -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Drivers" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                        <ItemsControl ItemsSource="{Binding DriverRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected}" Margin="0,1">
                                        <TextBlock>
                                            <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/>
                                            <Run Text="  "/>
                                            <Run Text="{Binding Detail, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </TextBlock>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Expander>

            <!-- WORK AREA: pool | loops | bill -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="240"/>
                </Grid.ColumnDefinitions>

                <!-- ZONE POOL (unassigned zones — the multi-select assignment source) -->
                <DockPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock DockPanel.Dock="Top" Text="ZONE POOL" Style="{StaticResource SectionHeader}" Margin="0,0,0,2"/>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource HintText}"
                               Text="Unassigned — engine auto-packs. Select, then '+ Add' on a loop."/>
                    <Button DockPanel.Dock="Bottom" Content="+ New empty loop" Padding="6,3" Margin="0,4,0,0"
                            Command="{Binding NewEmptyLoopCommand}"/>
                    <Button DockPanel.Dock="Bottom" Content="+ New loop from selection" Padding="6,3" Margin="0,4,0,0"
                            Command="{Binding NewLoopFromSelectionCommand}"/>
                    <ListBox ItemsSource="{Binding ZonePool}" SelectionMode="Extended"
                             BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="1">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Display}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <!-- LOOPS (tree: loop → zones → clusters) -->
                <DockPanel Grid.Column="1" Margin="0,0,8,0">
                    <TextBlock DockPanel.Dock="Top" Text="LOOPS" Style="{StaticResource SectionHeader}" Margin="0,0,0,2"/>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding BuilderStatus}" Style="{StaticResource HintText}"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Loops}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="1"
                                            Padding="6" Margin="0,0,0,6">
                                        <StackPanel>
                                            <!-- Loop header: name · Rsv · +Add · Place · One-line · ✕ -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                         VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="Rsv" VerticalAlignment="Center" Margin="8,0,3,0"
                                                           Style="{StaticResource FieldLabel}"
                                                           ToolTip="Channels reserved on this loop's interface for smart fixtures (§3c). 0 = none. Edge case — leave 0 unless this loop has DMX-addressable fixtures the tape packer doesn't place."/>
                                                <TextBox Grid.Column="2" Width="34" VerticalAlignment="Center"
                                                         Text="{Binding ReservedChannels, UpdateSourceTrigger=LostFocus}"
                                                         ToolTip="Channels reserved on this loop's interface for smart fixtures (§3c). 0 = none. Edge case — leave 0 unless this loop has DMX-addressable fixtures the tape packer doesn't place."/>
                                                <Button Grid.Column="3" Content="+ Add" Padding="6,2" Margin="6,0,0,0"
                                                        Command="{Binding AddSelectedCommand}"
                                                        ToolTip="Add the zones selected in the pool to this loop."/>
                                                <Button Grid.Column="4" Content="Place ▸" Padding="6,2" Margin="4,0,0,0"
                                                        Command="{Binding PlaceCommand}"
                                                        ToolTip="Pick a point and place this loop's decoders + drivers."/>
                                                <Button Grid.Column="5" Content="One-line ▸" Padding="6,2" Margin="4,0,0,0"
                                                        Command="{Binding DrawOneLineCommand}"
                                                        ToolTip="Draw/redraw this loop's one-line on its own Drafting View."/>
                                                <Button Grid.Column="6" Content="✕" Padding="6,2" Margin="4,0,0,0"
                                                        Command="{Binding RemoveCommand}"
                                                        ToolTip="Delete this loop — its zones return to the pool."/>
                                            </Grid>

                                            <!-- Zones in this loop -->
                                            <ItemsControl ItemsSource="{Binding Zones}" Margin="14,4,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,0,0,1"
                                                                Padding="0,2">
                                                            <StackPanel>
                                                                <!-- Zone header: name (N runs) · +from selection · ← -->
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0" Text="{Binding Header}" VerticalAlignment="Center"
                                                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                                                    <Button Grid.Column="1" Content="+ from selection" Padding="6,1" Margin="4,0,0,0"
                                                                            Command="{Binding NewClusterCommand}"
                                                                            Visibility="{Binding CanSplit, Converter={StaticResource BoolToVisibility}}"
                                                                            ToolTip="Split this zone: select tape runs in the model, then click."/>
                                                                    <Button Grid.Column="2" Content="←" Padding="6,1" Margin="4,0,0,0"
                                                                            Command="{Binding RemoveFromLoopCommand}"
                                                                            ToolTip="Return this zone to the pool."/>
                                                                </Grid>

                                                                <!-- Cluster sub-builder (only when the zone spans ≥2 runs) -->
                                                                <StackPanel Margin="12,2,0,2"
                                                                            Visibility="{Binding CanSplit, Converter={StaticResource BoolToVisibility}}">
                                                                    <TextBlock Text="{Binding ResidualText}" Foreground="{StaticResource TextSecondaryBrush}"
                                                                               Visibility="{Binding HasClusters, Converter={StaticResource BoolToVisibility}}"/>
                                                                    <ItemsControl ItemsSource="{Binding Clusters}">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <Grid Margin="0,1">
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="*"/>
                                                                                        <ColumnDefinition Width="Auto"/>
                                                                                        <ColumnDefinition Width="Auto"/>
                                                                                        <ColumnDefinition Width="Auto"/>
                                                                                        <ColumnDefinition Width="Auto"/>
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <TextBox Grid.Column="0" Text="{Binding Name, UpdateSourceTrigger=LostFocus}"/>
                                                                                    <TextBlock Grid.Column="1" Text="{Binding RunCount}" Margin="6,0"
                                                                                               VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                                    <Button Grid.Column="2" Content="Verify" Padding="6,1" Margin="2,0"
                                                                                            Command="{Binding VerifyCommand}"/>
                                                                                    <Button Grid.Column="3" Content="+Sel" Padding="6,1" Margin="2,0"
                                                                                            Command="{Binding AddSelectionCommand}"/>
                                                                                    <Button Grid.Column="4" Content="✕" Padding="6,1" Margin="2,0"
                                                                                            Command="{Binding RemoveCommand}"/>
                                                                                </Grid>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>

                <!-- BILL (always-on whole-system roll-up) -->
                <Border Grid.Column="2" BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="1,0,0,0"
                        Padding="12,0,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="BILL" Style="{StaticResource SectionHeader}"/>

                        <Border DockPanel.Dock="Top" Margin="0,2,0,8" Padding="6"
                                Background="{StaticResource FooterBgBrush}">
                            <TextBlock Text="{Binding Bill.StatusMessage}" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Bill.IsError}" Value="True">
                                                <Setter Property="Foreground" Value="#C0392B"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Bill.HasResult}" Value="True">
                                                <Setter Property="Foreground" Value="#1E8449"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>

                        <!-- REVIEW verdicts (§8c) — amber list, shown only when Locked + a conflict exists -->
                        <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Bill.Reviews}"
                                      Visibility="{Binding Bill.NeedsReview, Converter={StaticResource BoolToVisibility}}"
                                      Margin="0,0,0,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FFF3CD" Padding="6" Margin="0,0,0,4">
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="#7A5B00"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Interfaces" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Bill.InterfaceCount}" Style="{StaticResource BillNumber}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Decoders" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Bill.Decoders}" Style="{StaticResource BillNumber}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Drivers" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Bill.Drivers}" Style="{StaticResource BillNumber}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Breakers" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Bill.Breakers}" Style="{StaticResource BillNumber}"/>
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Channels" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Bill.ChannelsText}" Style="{StaticResource BillNumber}"/>
                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Processors" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Bill.Processors}" Style="{StaticResource BillNumber}"/>
                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Repeaters" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Bill.Repeaters}" Style="{StaticResource BillNumber}"/>
                                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Total W" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Bill.TotalWattsText}" Style="{StaticResource BillNumber}"/>
                                </Grid>

                                <TextBlock Text="Decoder BOM" Style="{StaticResource SectionHeader}"/>
                                <ItemsControl ItemsSource="{Binding Bill.DecoderBom}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Display}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="Driver BOM" Style="{StaticResource SectionHeader}"/>
                                <ItemsControl ItemsSource="{Binding Bill.DriverBom}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Display}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Wire legend (Phase 6): dense, per-job numbering — the same numbers the
                                     one-line stamps on each wire. Only types actually used appear. -->
                                <TextBlock Text="Wire Legend" Style="{StaticResource SectionHeader}"/>
                                <ItemsControl ItemsSource="{Binding WireLegend}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,1,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="24"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Number}" Style="{StaticResource BillNumber}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Label}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Content="Legend view ▸" Command="{Binding DrawWireLegendCommand}"
                                        HorizontalAlignment="Left" Margin="0,6,0,0" Padding="8,3"
                                        ToolTip="Generate (or redraw) the one per-job wire-legend drafting view you can place on a sheet — same numbers as the one-line."/>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Lifecycle bar -->
        <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{StaticResource SeparatorBrush}"
                Padding="12,8" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding PlacementStatus}" TextWrapping="Wrap"
                           VerticalAlignment="Center" Margin="0,0,12,0"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{Binding LockButtonText}" Command="{Binding LockCommand}" MinWidth="68" Padding="8,3" Margin="0,0,6,0"
                            ToolTip="Lock: snapshot the current numbering as the issued baseline (§8c) — re-runs then preserve issued DEC #s and flag conflicts as REVIEW. Press again while Locked to re-baseline (re-issue) without renumbering — confirmed."/>
                    <Button Content="Unlock" Command="{Binding UnlockCommand}" MinWidth="68" Padding="8,3" Margin="0,0,12,0"
                            ToolTip="Return to free renumbering (clobber) — confirmed."/>
                    <Button Content="Refresh" Command="{Binding RefreshCommand}" MinWidth="80" Padding="10,3"
                            ToolTip="Re-read the model (zones, fixtures, loaded decoder/driver types) and re-solve — preserving your declarations. The bill re-solves automatically whenever you change a declaration, so use this when the model itself changed."/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
