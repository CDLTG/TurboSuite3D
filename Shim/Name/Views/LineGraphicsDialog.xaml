<Window x:Class="TurboSuite.Name.Views.LineGraphicsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Line Graphics" SizeToContent="Height" Width="380"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontSize="11">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TurboSuite;component/Shared/Styles/TurboSuiteStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Header="Lines" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Pattern -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Pattern:" VerticalAlignment="Center"
                           Margin="0,0,12,0"/>
                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="PatternCombo"
                          DisplayMemberPath="Name" Margin="0,0,0,8" Height="24"/>

                <!-- Color -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Color:" VerticalAlignment="Center"
                           Margin="0,0,12,0"/>
                <Button Grid.Row="1" Grid.Column="1" x:Name="ColorButton" Style="{StaticResource RevitButtonStyle}"
                        Padding="6,3" HorizontalContentAlignment="Left" Margin="0,0,0,8" Height="26"
                        Click="ColorButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="ColorSwatch" Width="26" Height="14" BorderBrush="#888888"
                                BorderThickness="1" Margin="0,0,8,0"/>
                        <TextBlock x:Name="ColorLabel" VerticalAlignment="Center" Text="&lt;No Override&gt;"/>
                    </StackPanel>
                </Button>

                <!-- Weight -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Weight:" VerticalAlignment="Center"
                           Margin="0,0,12,0"/>
                <ComboBox Grid.Row="2" Grid.Column="1" x:Name="WeightCombo" Height="24"/>
            </Grid>
        </GroupBox>

        <!-- Buttons: Clear Overrides on the left, OK/Cancel on the right (mirrors native) -->
        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Button Content="Clear Overrides" HorizontalAlignment="Left" Style="{StaticResource RevitButtonStyle}"
                    Padding="12,4" Click="ClearButton_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="OK" Width="72" Style="{StaticResource PrimaryButtonStyle}"
                        Margin="0,0,8,0" Click="OkButton_Click"/>
                <Button Content="Cancel" Width="72" Style="{StaticResource RevitButtonStyle}"
                        Click="CancelButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
