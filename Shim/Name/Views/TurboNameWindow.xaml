<Window
    x:Class="TurboSuite.Name.Views.TurboNameWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="TurboName"
    SizeToContent="Height" Width="420"
    MinWidth="380"
    WindowStartupLocation="CenterScreen"
    FontFamily="Segoe UI" FontSize="11"
    ResizeMode="NoResize">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TurboSuite;component/Shared/Styles/TurboSuiteStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Generate Regions section -->
        <GroupBox Grid.Row="0" Header="Generate Regions" Padding="12,8" Style="{StaticResource BoldHeaderGroupBox}">
            <StackPanel>
                <TextBlock TextWrapping="Wrap"
                           Text="Draw Room Region filled regions interactively. Rectangle mode (two clicks) for simple rooms, Polygon mode (multi-click) for complex shapes."/>
                <Button Content="Generate" Width="80" HorizontalAlignment="Right" Margin="0,8,0,0"
                        Style="{StaticResource RevitButtonStyle}"
                        Command="{Binding RunGenerateCommand}"/>
            </StackPanel>
        </GroupBox>

        <!-- Assign Room Names section -->
        <GroupBox Grid.Row="2" Header="Assign Room Names" Padding="12,8" Style="{StaticResource BoldHeaderGroupBox}">
            <StackPanel>
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                           Text="Reads linked DWG files to extract room names and ceiling heights, assigns them to Room Region filled regions, and places TextNotes."/>
                <Button Content="Run" Width="80" HorizontalAlignment="Right" Margin="0,8,0,0"
                        Style="{StaticResource RevitButtonStyle}"
                        Command="{Binding RunAssignCommand}"/>
            </StackPanel>
        </GroupBox>

        <!-- Close button -->
        <Button Grid.Row="4" Content="Close" Width="80" HorizontalAlignment="Right" Margin="0,12,0,0"
                Style="{StaticResource RevitButtonStyle}"
                Click="CloseButton_Click" IsCancel="True"/>
    </Grid>
</Window>
