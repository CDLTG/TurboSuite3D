<Window
    x:Class="TurboSuite.Name.Views.TurboNameWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="TurboName"
    SizeToContent="Height" Width="520"
    MinWidth="500"
    WindowStartupLocation="Manual"
    FontFamily="Segoe UI" FontSize="11"
    ResizeMode="NoResize">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TurboSuite;component/Shared/Styles/TurboSuiteStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <!-- Compact per-row role toggle. Squared (CornerRadius=0). Active fill passed via Tag. -->
            <Style x:Key="RoleToggleBase" TargetType="ToggleButton">
                <Setter Property="Width" Value="22"/>
                <Setter Property="Height" Value="19"/>
                <Setter Property="Margin" Value="1,0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="bd" BorderBrush="#AAAAAA" BorderThickness="1" Background="#F5F5F5">
                                <TextBlock Text="{TemplateBinding Content}" HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="bd" Property="Background"
                                            Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                                    <Setter TargetName="bd" Property="BorderBrush" Value="#333333"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- Region-gen roles turn red (mirrors the watershed preview in the view). Tag is a Brush so the
                 template's IsChecked trigger can bind it straight to Background. -->
            <Style x:Key="RoleToggleRed" TargetType="ToggleButton" BasedOn="{StaticResource RoleToggleBase}">
                <Setter Property="Tag">
                    <Setter.Value><SolidColorBrush Color="#D01E1E"/></Setter.Value>
                </Setter>
            </Style>
            <!-- Text-scope roles (Name/Ht) turn blue. -->
            <Style x:Key="RoleToggleBlue" TargetType="ToggleButton" BasedOn="{StaticResource RoleToggleBase}">
                <Setter Property="Tag">
                    <Setter.Value><SolidColorBrush Color="#2B579A"/></Setter.Value>
                </Setter>
            </Style>

            <!-- Rounded, borderless pill for assigned tags (Room Name chips + the Ceiling Height value). Muted
                 fill, no border — deliberately unlike the squared, bordered buttons elsewhere. -->
            <Style x:Key="TagPill" TargetType="Border">
                <Setter Property="Background" Value="#EDEFF2"/>
                <Setter Property="CornerRadius" Value="9"/>
                <Setter Property="Padding" Value="9,2"/>
                <Setter Property="Margin" Value="0,0,5,3"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <!-- Borderless glyph button (the ✕ on chips and the clear-affordance beside single-selects). No
                 button chrome — just the glyph, muted, darkening on hover — so it never reads as a button. -->
            <Style x:Key="IconButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Foreground" Value="#999999"/>
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="#D01E1E"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" MaxHeight="740">
            <StackPanel>

                <!-- Linked CAD Layers — the config surface: live show/hide + role tagging -->
                <GroupBox Header="Linked CAD Layers (2D Workflow)" Margin="0,0,0,10" Padding="12,8"
                          Style="{StaticResource BoldHeaderGroupBox}">
                    <StackPanel Margin="4">
                        <TextBlock Text="Check to show/hide a layer (mirrors VG → Imported Categories, persists). Tag roles per layer: W/D/A = region-gen wall/door/area (paints red), N/H = room name / ceiling height text."
                                   Foreground="#555555" Margin="0,0,0,8" TextWrapping="Wrap"/>

                        <!-- Room-source mode: read-only status (auto-detected by "Pick from view…"); drives Name/Ht columns + the room-source sub-panel below -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                                    ToolTip="Block vs. Text is detected automatically when you Pick from view — Block Attributes if you click a block, Text on Layer if you click room-label text.">
                            <TextBlock Text="Room source:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding CadConfig.RoomSourceModeDisplay}" VerticalAlignment="Center"
                                       FontWeight="SemiBold" Foreground="#2B579A"/>
                            <TextBlock Text="&#160;— set by “Pick from view…”" VerticalAlignment="Center" Foreground="#888888"/>
                        </StackPanel>

                        <!-- Find filter -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Find:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding LayerFilterText, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <!-- Per-file collapsible groups: [vis] [W][D][A][N][H] LayerName -->
                        <Border BorderBrush="#CCCCCC" BorderThickness="1">
                            <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding LayersView}">
                                    <ItemsControl.GroupStyle>
                                        <GroupStyle>
                                            <GroupStyle.ContainerStyle>
                                                <Style TargetType="{x:Type GroupItem}">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="{x:Type GroupItem}">
                                                                <Expander IsExpanded="True" Padding="0"
                                                                          Margin="0,2,0,0">
                                                                    <Expander.Header>
                                                                        <TextBlock Text="{Binding Name}"
                                                                                   FontWeight="SemiBold"
                                                                                   TextTrimming="CharacterEllipsis"/>
                                                                    </Expander.Header>
                                                                    <ItemsPresenter Margin="16,2,0,4"/>
                                                                </Expander>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </GroupStyle.ContainerStyle>
                                        </GroupStyle>
                                    </ItemsControl.GroupStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                                <CheckBox IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                                          VerticalAlignment="Center" Margin="0,0,4,0"
                                                          ToolTip="Show/hide this layer in the view"/>
                                                <ToggleButton Content="W" Style="{StaticResource RoleToggleRed}"
                                                              IsChecked="{Binding IsWall}" ToolTip="Wall layer (region-gen)"/>
                                                <ToggleButton Content="D" Style="{StaticResource RoleToggleRed}"
                                                              IsChecked="{Binding IsDoor}" ToolTip="Door layer (region-gen)"/>
                                                <ToggleButton Content="A" Style="{StaticResource RoleToggleRed}"
                                                              IsChecked="{Binding IsArea}" ToolTip="Area/envelope layer (region-gen)"/>
                                                <ToggleButton Content="N" Style="{StaticResource RoleToggleBlue}"
                                                              IsChecked="{Binding IsName}" ToolTip="Room-name text layer"
                                                              Visibility="{Binding DataContext.CadConfig.IsTextMode, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}, Converter={StaticResource BoolToVis}}"/>
                                                <ToggleButton Content="H" Style="{StaticResource RoleToggleBlue}"
                                                              IsChecked="{Binding IsHeight}" ToolTip="Ceiling-height text layer"
                                                              Visibility="{Binding DataContext.CadConfig.IsTextMode, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}, Converter={StaticResource BoolToVis}}"/>
                                                <TextBlock Text="{Binding LayerName}" VerticalAlignment="Center"
                                                           Margin="6,0,0,0" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding LayerName}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </GroupBox>

                <!-- CAD Room Source configuration -->
                <GroupBox Header="CAD Room Source (2D Workflow)" Margin="0,0,0,10" Padding="12,8"
                          Style="{StaticResource BoldHeaderGroupBox}">
                    <StackPanel Margin="4">
                        <TextBlock Text="Room names/heights are scoped by the N/H (Text) or block (below) tags — the picked layer's DWG becomes the link scope, so a co-linked RCP sharing a layer no longer double-seeds each room."
                                   Foreground="#555555" Margin="0,0,0,8" TextWrapping="Wrap"/>

                        <!-- Pick-from-view discovery -->
                        <StackPanel Margin="0,0,0,8">
                            <Button Content="Pick from view…" HorizontalAlignment="Left"
                                    Command="{Binding CadConfig.PickFromViewCommand}"
                                    Style="{StaticResource RevitButtonStyle}"
                                    Padding="12,5" MinWidth="120"
                                    ToolTip="Click a room label in the linked CAD. The block/text mode, layer, and DWG scope are detected automatically."/>
                            <TextBlock Text="{Binding CadConfig.DetectedText}" Foreground="#2B579A" FontSize="10"
                                       Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Block mode fields (pick-driven; no free typing) -->
                        <StackPanel Visibility="{Binding CadConfig.IsBlockMode, Converter={StaticResource BoolToVis}}"
                                    Margin="0,0,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <!-- Dropdown shrunk to 0.75x its former even-split width (0.6*/1* = 0.375 vs 0.5); pills take the rest -->
                                    <ColumnDefinition Width="0.6*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Block Name:"
                                           VerticalAlignment="Center" Margin="0,0,8,6"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" VerticalAlignment="Center"
                                           Margin="0,0,0,6" FontWeight="SemiBold" Text="{Binding CadConfig.BlockName}"/>

                                <!-- Row: dropdown (left) assigns; pills (right) show what's assigned -->
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Room Name Tags:"
                                           VerticalAlignment="Center" Margin="0,0,8,6"/>
                                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="RoomNameAddCombo"
                                          VerticalAlignment="Center" Margin="0,0,8,6"
                                          ItemsSource="{Binding CadConfig.UnassignedTags}"
                                          SelectionChanged="RoomNameAddCombo_SelectionChanged"
                                          DropDownOpened="OnDiscoveryDropDownOpened"
                                          ToolTip="Add an attribute to the room name (joined in the order you add them)"/>
                                <ItemsControl Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,0,6"
                                              ItemsSource="{Binding CadConfig.RoomNameTags}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource TagPill}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" Foreground="#333333"/>
                                                    <Button Content="✕" Margin="6,0,0,0" ToolTip="Remove"
                                                            Style="{StaticResource IconButton}"
                                                            Command="{Binding DataContext.CadConfig.RemoveRoomNameTagCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Ceiling Height Tag:"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox Grid.Row="2" Grid.Column="1" x:Name="CeilingHeightCombo"
                                          VerticalAlignment="Center" Margin="0,0,8,0"
                                          ItemsSource="{Binding CadConfig.UnassignedTags}"
                                          SelectionChanged="CeilingHeightCombo_SelectionChanged"
                                          DropDownOpened="OnDiscoveryDropDownOpened"
                                          ToolTip="Pick the attribute that holds the ceiling height"/>
                                <Border Grid.Row="2" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource TagPill}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CadConfig.CeilingHeightTag}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CadConfig.CeilingHeightTag}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding CadConfig.CeilingHeightTag}" VerticalAlignment="Center" Foreground="#333333"/>
                                        <Button Content="✕" Margin="6,0,0,0" ToolTip="Clear"
                                                Style="{StaticResource IconButton}"
                                                Command="{Binding CadConfig.ClearCeilingHeightTagCommand}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <TextBlock Text="Room name = the tag values joined in the order added. All tags come from the picked block — no typing."
                                       Foreground="#888888" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Text mode: optional ceiling-height-from-block override (names/heights layers are row tags) -->
                        <StackPanel Visibility="{Binding CadConfig.IsTextMode, Converter={StaticResource BoolToVis}}"
                                    Margin="0,0,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <!-- Dropdown shrunk to 0.75x its former even-split width (0.6*/1* = 0.375 vs 0.5); pills take the rest -->
                                    <ColumnDefinition Width="0.6*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Height Block (opt):"
                                           VerticalAlignment="Center" Margin="0,0,8,6"/>
                                <!-- Button alone in col 1 (stretched) so it matches the dropdown width below; name + clear live in col 2 -->
                                <Button Grid.Row="0" Grid.Column="1" Content="Pick height block…"
                                        Command="{Binding CadConfig.PickHeightBlockCommand}"
                                        Style="{StaticResource RevitButtonStyle}" Padding="10,3"
                                        HorizontalAlignment="Stretch" Margin="0,0,8,6"
                                        ToolTip="Click the ceiling-height block in the linked CAD."/>
                                <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding CadConfig.CeilingHeightBlockName}" FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                    <Button Content="✕" Margin="6,0,0,0" ToolTip="Clear height block"
                                            Command="{Binding CadConfig.ClearHeightBlockCommand}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CadConfig.CeilingHeightBlockName}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding CadConfig.CeilingHeightBlockName}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Height Block Tag:"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="HeightBlockTagCombo"
                                          VerticalAlignment="Center" Margin="0,0,8,0"
                                          ItemsSource="{Binding CadConfig.UnassignedCeilingBlockTags}"
                                          SelectionChanged="HeightBlockTagCombo_SelectionChanged"
                                          DropDownOpened="OnDiscoveryDropDownOpened"
                                          ToolTip="Pick the attribute that holds the ceiling height"/>
                                <Border Grid.Row="1" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource TagPill}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CadConfig.CeilingHeightBlockTag}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CadConfig.CeilingHeightBlockTag}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding CadConfig.CeilingHeightBlockTag}" VerticalAlignment="Center" Foreground="#333333"/>
                                        <Button Content="✕" Margin="6,0,0,0" ToolTip="Clear"
                                                Style="{StaticResource IconButton}"
                                                Command="{Binding CadConfig.ClearHeightBlockTagCommand}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <TextBlock Text="Tag the room-name layer N and the height layer H on the rows above. Optionally, heights can instead come from a block — Pick it here (leave blank to use the H layer)."
                                       Foreground="#888888" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- CAD settings above are dirty-tracked and saved when the window closes. -->

                <!-- Generate Regions section (merged from the former standalone GenerateRegions window) -->
                <GroupBox Header="Generate Regions" Padding="12,8" Margin="0,0,0,12" Style="{StaticResource BoldHeaderGroupBox}">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="Draw Room Region filled regions interactively (Rectangle / Polygon), or Auto-generate them from the CAD room labels (uses the W/D/A-tagged layers above)."/>

                        <!-- Region type -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Region Type Name:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox Grid.Column="1" x:Name="RegionTypeCombo"
                                      ItemsSource="{Binding CadConfig.RegionTypeNames}"
                                      SelectedItem="{Binding CadConfig.RegionTypeName, Mode=TwoWay}"
                                      DropDownOpened="RegionTypeCombo_DropDownOpened"
                                      ToolTip="The FilledRegionType generated regions are created as. Only types that already exist in the project are listed."/>
                        </Grid>

                        <!-- Result counts -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Created: " FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding CreatedCount}"/>
                            <TextBlock Text="  |  Failed: " FontWeight="SemiBold" Margin="4,0,0,0"/>
                            <TextBlock Text="{Binding FailedCount}"/>
                        </StackPanel>

                        <!-- Diagnostic status -->
                        <TextBlock Text="{Binding StatusText}" Foreground="#888888" FontSize="9.5"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="30"/>

                        <!-- Picking hint (visible while a pick loop is live) -->
                        <TextBlock Text="{Binding PickingHint}" Foreground="#555555" FontSize="11" Margin="0,4,0,0"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding IsPicking, Converter={StaticResource BoolToVis}}"/>

                        <!-- Action buttons (hidden while picking) -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPicking}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Button Content="Auto-generate" MinWidth="100" Margin="0,0,8,0"
                                    Style="{StaticResource RevitButtonStyle}"
                                    Command="{Binding AutoGenerateCommand}"/>
                            <Button Content="Rectangle" MinWidth="80" Margin="0,0,8,0"
                                    Style="{StaticResource RevitButtonStyle}"
                                    Command="{Binding RectangleCommand}"/>
                            <Button Content="Polygon" MinWidth="80"
                                    Style="{StaticResource RevitButtonStyle}"
                                    Command="{Binding PolygonCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- Assign Room Names section -->
                <GroupBox Header="Assign Room Names" Padding="12,8" Style="{StaticResource BoldHeaderGroupBox}">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="Reads the linked DWG to extract room names and ceiling heights, assigns them to Room Region filled regions, and places TextNotes."/>
                        <Button Content="Run" Width="80" HorizontalAlignment="Right" Margin="0,8,0,0"
                                Style="{StaticResource RevitButtonStyle}"
                                Command="{Binding RunAssignCommand}"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- Close button -->
        <Button Grid.Row="1" Content="Close" Width="80" HorizontalAlignment="Right" Margin="0,12,0,0"
                Style="{StaticResource RevitButtonStyle}"
                Click="CloseButton_Click"/>
    </Grid>
</Window>
