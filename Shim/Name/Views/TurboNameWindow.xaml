<Window
    x:Class="TurboSuite.Name.Views.TurboNameWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="TurboName"
    SizeToContent="Height" Width="520"
    MinWidth="500"
    WindowStartupLocation="Manual"
    FontFamily="Segoe UI" FontSize="11"
    ResizeMode="NoResize">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TurboSuite;component/Shared/Styles/TurboSuiteStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <!-- Compact per-row role toggle. Squared (CornerRadius=0). Active fill passed via Tag. -->
            <Style x:Key="RoleToggleBase" TargetType="ToggleButton">
                <Setter Property="Width" Value="22"/>
                <Setter Property="Height" Value="19"/>
                <Setter Property="Margin" Value="1,0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="bd" BorderBrush="#AAAAAA" BorderThickness="1" Background="#F5F5F5">
                                <TextBlock Text="{TemplateBinding Content}" HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="bd" Property="Background"
                                            Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                                    <Setter TargetName="bd" Property="BorderBrush" Value="#333333"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- Region-gen roles turn red (mirrors the watershed preview in the view). Tag is a Brush so the
                 template's IsChecked trigger can bind it straight to Background. -->
            <Style x:Key="RoleToggleRed" TargetType="ToggleButton" BasedOn="{StaticResource RoleToggleBase}">
                <Setter Property="Tag">
                    <Setter.Value><SolidColorBrush Color="#D01E1E"/></Setter.Value>
                </Setter>
            </Style>
            <!-- Text-scope roles (Name/Ht) turn blue. -->
            <Style x:Key="RoleToggleBlue" TargetType="ToggleButton" BasedOn="{StaticResource RoleToggleBase}">
                <Setter Property="Tag">
                    <Setter.Value><SolidColorBrush Color="#2B579A"/></Setter.Value>
                </Setter>
            </Style>

            <!-- Squared toggle for the global red watershed preview. Matches RevitButtonStyle (the "Pick from
                 view…" look: same bg/border, hand cursor, blue hover); when checked it turns red to signal the
                 preview is live in the view. -->
            <Style x:Key="WatershedToggle" TargetType="ToggleButton">
                <Setter Property="Background" Value="{StaticResource ButtonBgBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource ButtonBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="16,4"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="0"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#DCECFC"/>
                                    <Setter TargetName="bd" Property="BorderBrush" Value="#7EB4EA"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#C4E0FC"/>
                                    <Setter TargetName="bd" Property="BorderBrush" Value="#569DE5"/>
                                </Trigger>
                                <!-- Checked wins over hover: the live preview reads red no matter the pointer. -->
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#D01E1E"/>
                                    <Setter TargetName="bd" Property="BorderBrush" Value="#8E1414"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Line-preview swatch that doubles as the Line Graphics button (native "Lines" column). Chromeless
                 so the rendered line reads clean; subtle hover, dimmed when disabled (preview on / picking). -->
            <Style x:Key="LineSwatchButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="wrap" Background="Transparent" Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="wrap" Property="Background" Value="#EEF3FB"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Rounded, borderless pill for assigned tags (Room Name chips + the Ceiling Height value). Muted
                 fill, no border — deliberately unlike the squared, bordered buttons elsewhere. -->
            <Style x:Key="TagPill" TargetType="Border">
                <Setter Property="Background" Value="#EDEFF2"/>
                <Setter Property="CornerRadius" Value="9"/>
                <Setter Property="Padding" Value="9,2"/>
                <Setter Property="Margin" Value="0,0,5,3"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <!-- Borderless glyph button (the ✕ on chips and the clear-affordance beside single-selects). No
                 button chrome — just the glyph, muted, darkening on hover — so it never reads as a button. -->
            <Style x:Key="IconButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Foreground" Value="#999999"/>
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="#D01E1E"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- No hardcoded height cap: the window grows upward from its bottom-right anchor to fit the content.
             MaxHeight is set at load from the screen's work area (OnLoaded) purely as a last-resort guard, so a
             shorter display gets a scrollbar instead of a window running off the top. -->
        <ScrollViewer x:Name="ContentScroll" Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Linked CAD Layers — the config surface: live show/hide + role tagging -->
                <GroupBox Header="Linked CAD Layers (2D Workflow)" Margin="0,0,0,8" Padding="10,6"
                          Style="{StaticResource BoldHeaderGroupBox}">
                    <StackPanel>
                        <!-- Legend only. Everything else this used to spell out (the checkbox mirroring VG,
                             Ctrl/Shift multi-select, what the red preview does) now lives in the tooltips of the
                             controls that do it — vertical space in this window is worth more than prose. -->
                        <TextBlock Foreground="#555555" Margin="0,0,0,6" TextWrapping="Wrap"
                                   Text="W/D/A = wall / door / area (region-gen)  ·  N/H = room name / ceiling height"
                                   ToolTip="Check a layer to show/hide it in the view (mirrors VG → Imported Categories, and persists). Tag roles per layer with the W/D/A/N/H buttons. Ctrl/Shift-click layer names to select several — the checkbox, tags, and line edits then apply to the whole selection."/>

                        <!-- Room-source mode: read-only status (auto-detected by "Pick from view…"); drives Name/Ht columns + the room-source sub-panel below -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                                    ToolTip="Block vs. Text is detected automatically when you Pick from view — Block Attributes if you click a block, Text on Layer if you click room-label text.">
                            <TextBlock Text="Room source:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding CadConfig.RoomSourceModeDisplay}" VerticalAlignment="Center"
                                       FontWeight="SemiBold" Foreground="#2B579A"/>
                            <TextBlock Text="&#160;— set by “Pick from view…”" VerticalAlignment="Center" Foreground="#888888"/>
                        </StackPanel>

                        <!-- Global red watershed preview + click-to-hide. Both light up red while live. -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ToggleButton Content="Preview watershed" Style="{StaticResource WatershedToggle}"
                                          Margin="0,0,8,0"
                                          IsChecked="{Binding IsPreviewActive, Mode=OneWay}"
                                          Command="{Binding TogglePreviewCommand}"
                                          ToolTip="Paints every W/D/A-tagged layer red so you can verify the watershed structure will hold. Off by default; turns off automatically if you change the W/D/A tags — press again to re-check. Line editing is disabled while this is on."/>
                            <!-- Native Import Instance ▸ Query ▸ "Hide in view", as a loop. Escape ends it — a
                                 running pick can't be cancelled from this window, so the button disables while lit. -->
                            <ToggleButton Content="Hide by picking" Style="{StaticResource WatershedToggle}"
                                          IsChecked="{Binding IsHidePicking, Mode=OneWay}"
                                          Command="{Binding HideByPickCommand}"
                                          ToolTip="Click CAD geometry in the view and its layer is hidden (same as Revit's Query ▸ Hide in view, and the same as unchecking it here). Keeps going until you press Escape."/>
                        </StackPanel>

                        <!-- Find filter -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Find:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding LayerFilterText, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <!-- Per-file collapsible groups: [vis] [W][D][A][N][H] LayerName.
                             ListBox (not ItemsControl) for native-VG-style Ctrl/Shift multi-select; SelectedItems
                             isn't bindable, so the code-behind pushes it to the VM. The in-row controls handle
                             their own mouse-down, so clicking a checkbox/tag/swatch edits without disturbing the
                             selection — selection is made by clicking the layer name or the empty row space. -->
                        <Border BorderBrush="#CCCCCC" BorderThickness="1">
                            <ListBox x:Name="LayerList" ItemsSource="{Binding LayersView}"
                                     MaxHeight="380" BorderThickness="0"
                                     SelectionMode="Extended"
                                     SelectionChanged="LayerList_SelectionChanged"
                                     HorizontalContentAlignment="Stretch"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ItemsControl.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.ContainerStyle>
                                            <Style TargetType="{x:Type GroupItem}">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="{x:Type GroupItem}">
                                                            <Expander IsExpanded="True" Padding="0"
                                                                      Margin="0,2,0,0">
                                                                <Expander.Header>
                                                                    <TextBlock Text="{Binding Name}"
                                                                               FontWeight="SemiBold"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                </Expander.Header>
                                                                <ItemsPresenter Margin="16,2,0,4"/>
                                                            </Expander>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </GroupStyle.ContainerStyle>
                                    </GroupStyle>
                                </ItemsControl.GroupStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- Native layout: [vis + W/D/A/N/H] | Layer Name (fills, ellipsizes) | line swatch -->
                                        <Grid Margin="0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                <CheckBox IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                                          VerticalAlignment="Center" Margin="0,0,4,0"
                                                          ToolTip="Show/hide this layer in the view"/>
                                                <ToggleButton Content="W" Style="{StaticResource RoleToggleRed}"
                                                              IsChecked="{Binding IsWall}" ToolTip="Wall layer (region-gen)"/>
                                                <ToggleButton Content="D" Style="{StaticResource RoleToggleRed}"
                                                              IsChecked="{Binding IsDoor}" ToolTip="Door layer (region-gen)"/>
                                                <ToggleButton Content="A" Style="{StaticResource RoleToggleRed}"
                                                              IsChecked="{Binding IsArea}" ToolTip="Area/envelope layer (region-gen)"/>
                                                <ToggleButton Content="N" Style="{StaticResource RoleToggleBlue}"
                                                              IsChecked="{Binding IsName}" ToolTip="Room-name text layer"
                                                              Visibility="{Binding DataContext.CadConfig.IsTextMode, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}, Converter={StaticResource BoolToVis}}"/>
                                                <ToggleButton Content="H" Style="{StaticResource RoleToggleBlue}"
                                                              IsChecked="{Binding IsHeight}" ToolTip="Ceiling-height text layer"
                                                              Visibility="{Binding DataContext.CadConfig.IsTextMode, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="1" Text="{Binding LayerName}" VerticalAlignment="Center"
                                                       Margin="6,0,8,0" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding LayerName}"/>

                                            <!-- Line-preview swatch = the Line Graphics button. Disabled while preview on / picking. -->
                                            <Button Grid.Column="2" Style="{StaticResource LineSwatchButton}"
                                                    Click="LineGraphicsButton_Click"
                                                    IsEnabled="{Binding DataContext.LineEditingEnabled, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                    ToolTip="Edit this layer's line color / weight / pattern (VG override)">
                                                <Border Width="120" Height="16" BorderBrush="#BBBBBB"
                                                        BorderThickness="1" Background="White">
                                                    <Line X1="5" Y1="8" X2="113" Y2="8"
                                                          Stroke="{Binding LinePreviewBrush}"
                                                          StrokeThickness="{Binding LinePreviewThickness}"
                                                          StrokeDashArray="{Binding LinePreviewDashArray}"
                                                          StrokeDashCap="Round" SnapsToDevicePixels="True"/>
                                                </Border>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ListBox>
                        </Border>
                    </StackPanel>
                </GroupBox>

                <!-- CAD Room Source configuration -->
                <GroupBox Header="CAD Room Source (2D Workflow)" Margin="0,0,0,8" Padding="10,6"
                          Style="{StaticResource BoldHeaderGroupBox}">
                    <StackPanel>
                        <!-- Pick-from-view discovery. (The per-link scoping note that used to sit here described
                             a fixed bug rather than how to drive the section — it's on the button's tooltip.) -->
                        <StackPanel Margin="0,0,0,8">
                            <Button Content="Pick from view…" HorizontalAlignment="Left"
                                    Command="{Binding CadConfig.PickFromViewCommand}"
                                    Style="{StaticResource RevitButtonStyle}"
                                    Padding="12,5" MinWidth="120"
                                    ToolTip="Click a room label in the linked CAD. The block/text mode, layer, and DWG scope are detected automatically — the picked layer's DWG becomes the link scope, so a co-linked RCP sharing a layer doesn't double-seed each room."/>
                            <TextBlock Text="{Binding CadConfig.DetectedText}" Foreground="#2B579A" FontSize="10"
                                       Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Block mode fields (pick-driven; no free typing) -->
                        <StackPanel Visibility="{Binding CadConfig.IsBlockMode, Converter={StaticResource BoolToVis}}"
                                    Margin="0,0,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <!-- Dropdown shrunk to 0.75x its former even-split width (0.6*/1* = 0.375 vs 0.5); pills take the rest -->
                                    <ColumnDefinition Width="0.6*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Block Name:"
                                           VerticalAlignment="Center" Margin="0,0,8,6"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" VerticalAlignment="Center"
                                           Margin="0,0,0,6" FontWeight="SemiBold" Text="{Binding CadConfig.BlockName}"/>

                                <!-- Row: dropdown (left) assigns; pills (right) show what's assigned -->
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Room Name Tags:"
                                           VerticalAlignment="Center" Margin="0,0,8,6"/>
                                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="RoomNameAddCombo"
                                          VerticalAlignment="Center" Margin="0,0,8,6"
                                          ItemsSource="{Binding CadConfig.UnassignedTags}"
                                          SelectionChanged="RoomNameAddCombo_SelectionChanged"
                                          DropDownOpened="OnDiscoveryDropDownOpened"
                                          ToolTip="Add an attribute to the room name — the values are joined in the order you add them. All tags come from the picked block; there's no typing."/>
                                <ItemsControl Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,0,6"
                                              ItemsSource="{Binding CadConfig.RoomNameTags}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource TagPill}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" Foreground="#333333"/>
                                                    <Button Content="✕" Margin="6,0,0,0" ToolTip="Remove"
                                                            Style="{StaticResource IconButton}"
                                                            Command="{Binding DataContext.CadConfig.RemoveRoomNameTagCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Ceiling Height Tag:"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox Grid.Row="2" Grid.Column="1" x:Name="CeilingHeightCombo"
                                          VerticalAlignment="Center" Margin="0,0,8,0"
                                          ItemsSource="{Binding CadConfig.UnassignedTags}"
                                          SelectionChanged="CeilingHeightCombo_SelectionChanged"
                                          DropDownOpened="OnDiscoveryDropDownOpened"
                                          ToolTip="Pick the attribute that holds the ceiling height"/>
                                <Border Grid.Row="2" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource TagPill}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CadConfig.CeilingHeightTag}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CadConfig.CeilingHeightTag}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding CadConfig.CeilingHeightTag}" VerticalAlignment="Center" Foreground="#333333"/>
                                        <Button Content="✕" Margin="6,0,0,0" ToolTip="Clear"
                                                Style="{StaticResource IconButton}"
                                                Command="{Binding CadConfig.ClearCeilingHeightTagCommand}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>

                        <!-- Text mode: optional ceiling-height-from-block override (names/heights layers are row tags) -->
                        <StackPanel Visibility="{Binding CadConfig.IsTextMode, Converter={StaticResource BoolToVis}}"
                                    Margin="0,0,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <!-- Dropdown shrunk to 0.75x its former even-split width (0.6*/1* = 0.375 vs 0.5); pills take the rest -->
                                    <ColumnDefinition Width="0.6*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Height Block (opt):"
                                           VerticalAlignment="Center" Margin="0,0,8,6"/>
                                <!-- Button alone in col 1 (stretched) so it matches the dropdown width below; name + clear live in col 2 -->
                                <Button Grid.Row="0" Grid.Column="1" Content="Pick height block…"
                                        Command="{Binding CadConfig.PickHeightBlockCommand}"
                                        Style="{StaticResource RevitButtonStyle}" Padding="10,3"
                                        HorizontalAlignment="Stretch" Margin="0,0,8,6"
                                        ToolTip="Click the ceiling-height block in the linked CAD."/>
                                <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding CadConfig.CeilingHeightBlockName}" FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                    <Button Content="✕" Margin="6,0,0,0" ToolTip="Clear height block"
                                            Command="{Binding CadConfig.ClearHeightBlockCommand}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CadConfig.CeilingHeightBlockName}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding CadConfig.CeilingHeightBlockName}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Height Block Tag:"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="HeightBlockTagCombo"
                                          VerticalAlignment="Center" Margin="0,0,8,0"
                                          ItemsSource="{Binding CadConfig.UnassignedCeilingBlockTags}"
                                          SelectionChanged="HeightBlockTagCombo_SelectionChanged"
                                          DropDownOpened="OnDiscoveryDropDownOpened"
                                          ToolTip="Pick the attribute that holds the ceiling height"/>
                                <Border Grid.Row="1" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource TagPill}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CadConfig.CeilingHeightBlockTag}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CadConfig.CeilingHeightBlockTag}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding CadConfig.CeilingHeightBlockTag}" VerticalAlignment="Center" Foreground="#333333"/>
                                        <Button Content="✕" Margin="6,0,0,0" ToolTip="Clear"
                                                Style="{StaticResource IconButton}"
                                                Command="{Binding CadConfig.ClearHeightBlockTagCommand}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <TextBlock Text="Heights come from the H layer, or from a block picked here."
                                       Foreground="#888888" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"
                                       ToolTip="Tag the room-name layer N and the height layer H on the rows above. Leave the height block blank to use the H layer."/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- CAD settings above are dirty-tracked and saved when the window closes. -->

                <!-- Generate Regions section (merged from the former standalone GenerateRegions window). Also
                     carries Assign names — it was a whole GroupBox for one button, and it's the same workflow:
                     make the regions, then name them. -->
                <GroupBox Header="Generate Regions &amp; Names" Padding="10,6" Style="{StaticResource BoldHeaderGroupBox}">
                    <StackPanel>
                        <!-- Region type. (What the three buttons do is on the buttons themselves + their tooltips.) -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Region Type Name:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox Grid.Column="1" x:Name="RegionTypeCombo"
                                      ItemsSource="{Binding CadConfig.RegionTypeNames}"
                                      SelectedItem="{Binding CadConfig.RegionTypeName, Mode=TwoWay}"
                                      DropDownOpened="RegionTypeCombo_DropDownOpened"
                                      ToolTip="The FilledRegionType generated regions are created as. Only types that already exist in the project are listed."/>
                        </Grid>

                        <!-- Result counts -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Created: " FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding CreatedCount}"/>
                            <TextBlock Text="  |  Failed: " FontWeight="SemiBold" Margin="4,0,0,0"/>
                            <TextBlock Text="{Binding FailedCount}"/>
                        </StackPanel>

                        <!-- Diagnostic status -->
                        <TextBlock Text="{Binding StatusText}" Foreground="#888888" FontSize="9.5"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="30"/>

                        <!-- Picking hint (visible while a pick loop is live) -->
                        <TextBlock Text="{Binding PickingHint}" Foreground="#555555" FontSize="11" Margin="0,4,0,0"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding IsPicking, Converter={StaticResource BoolToVis}}"/>

                        <!-- Action buttons (hidden while picking). Left = the naming pass, right = the three
                             region-drawing modes, so the row reads in workflow order: draw regions → name them. -->
                        <Grid Margin="0,8,0,0">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPicking}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Button Content="Assign names" MinWidth="90" HorizontalAlignment="Left"
                                    Style="{StaticResource RevitButtonStyle}"
                                    Command="{Binding RunAssignCommand}"
                                    ToolTip="Reads the linked DWG to extract room names and ceiling heights, assigns them to the Room Region filled regions, and places TextNotes. Run this after the regions exist."/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Auto-generate" MinWidth="100" Margin="0,0,8,0"
                                        Style="{StaticResource RevitButtonStyle}"
                                        Command="{Binding AutoGenerateCommand}"
                                        ToolTip="Generate a region per room in one pass, from the CAD room labels — bounded by the W/D/A-tagged layers above. Anything it can't cut cleanly is listed as “Needs manual” instead of being created wrong.&#x0a;&#x0a;If regions already exist, it asks first: clear them all, or clear just the ones you have selected in the view, and regenerate. Either way the clear and the regenerate are a single undo."/>
                                <Button Content="Rectangle" MinWidth="80" Margin="0,0,8,0"
                                        Style="{StaticResource RevitButtonStyle}"
                                        Command="{Binding RectangleCommand}"
                                        ToolTip="Draw regions by clicking two opposite corners, repeatedly. Escape to finish."/>
                                <Button Content="Polygon" MinWidth="80"
                                        Style="{StaticResource RevitButtonStyle}"
                                        Command="{Binding PolygonCommand}"
                                        ToolTip="Trace regions corner by corner. Escape closes the current shape; Escape again finishes."/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- Close button -->
        <Button Grid.Row="1" Content="Close" Width="80" HorizontalAlignment="Right" Margin="0,12,0,0"
                Style="{StaticResource RevitButtonStyle}"
                Click="CloseButton_Click"/>
    </Grid>
</Window>
