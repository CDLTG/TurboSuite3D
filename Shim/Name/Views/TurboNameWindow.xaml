<Window
    x:Class="TurboSuite.Name.Views.TurboNameWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="TurboName"
    SizeToContent="Height" Width="470"
    MinWidth="440"
    WindowStartupLocation="CenterScreen"
    FontFamily="Segoe UI" FontSize="11"
    ResizeMode="NoResize">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TurboSuite;component/Shared/Styles/TurboSuiteStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" MaxHeight="740">
            <StackPanel>

                <!-- CAD Room Source configuration -->
                <GroupBox Header="CAD Room Source (2D Workflow)" Margin="0,0,0,10" Padding="12,8"
                          Style="{StaticResource BoldHeaderGroupBox}">
                    <StackPanel Margin="4">
                        <TextBlock Text="Configure how room names and ceiling heights are extracted from the linked CAD file."
                                   Foreground="#555555" Margin="0,0,0,8" TextWrapping="Wrap"/>

                        <!-- Source link scope -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Source Link:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding CadConfig.AvailableSourceLinks}"
                                      SelectedItem="{Binding CadConfig.SelectedSourceLink}"
                                      ToolTip="Which linked DWG to read. Choose the floor plan so a co-linked RCP (sharing layer names) doesn't add stray geometry. (All links) reads every linked CAD."/>
                        </Grid>

                        <!-- Pick-from-view discovery -->
                        <StackPanel Margin="0,0,0,8">
                            <Button Content="Pick from view…" HorizontalAlignment="Left"
                                    Command="{Binding CadConfig.PickFromViewCommand}"
                                    Style="{StaticResource RevitButtonStyle}"
                                    Padding="12,5" MinWidth="120"
                                    ToolTip="Hide the window, then click a room label in the linked CAD. The block/text mode and layer are detected automatically."/>
                            <TextBlock Text="{Binding CadConfig.DetectedText}" Foreground="#2B579A" FontSize="10"
                                       Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Mode selection -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <RadioButton Content="Block Attributes" IsChecked="{Binding CadConfig.IsBlockMode}"
                                         Margin="0,0,16,0" VerticalContentAlignment="Center"/>
                            <RadioButton Content="Text on Layer" IsChecked="{Binding CadConfig.IsTextMode}"
                                         VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <!-- Block mode fields -->
                        <StackPanel Visibility="{Binding CadConfig.IsBlockMode, Converter={StaticResource BoolToVis}}"
                                    Margin="0,0,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Block Name:"
                                           VerticalAlignment="Center" Margin="0,0,8,6"/>
                                <ComboBox Grid.Row="0" Grid.Column="1"
                                          IsEditable="True" IsTextSearchEnabled="True"
                                          ItemsSource="{Binding CadConfig.AvailableBlockNames}"
                                          Text="{Binding CadConfig.BlockName, UpdateSourceTrigger=PropertyChanged}"
                                          DropDownOpened="OnDiscoveryDropDownOpened" Margin="0,0,0,6"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Room Name Tags:"
                                           VerticalAlignment="Center" Margin="0,0,8,6"/>
                                <TextBox Grid.Row="1" Grid.Column="1"
                                         Text="{Binding CadConfig.RoomNameTagsText, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,0,6"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Ceiling Height Tag:"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox Grid.Row="2" Grid.Column="1"
                                          IsEditable="True" IsTextSearchEnabled="True"
                                          ItemsSource="{Binding CadConfig.AvailableTags}"
                                          Text="{Binding CadConfig.CeilingHeightTag, UpdateSourceTrigger=PropertyChanged}"
                                          DropDownOpened="OnDiscoveryDropDownOpened"/>
                            </Grid>
                            <TextBlock Text="Room Name Tags: comma-separated, concatenated in order (e.g., 003, 002)"
                                       Foreground="#888888" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Text mode fields -->
                        <StackPanel Visibility="{Binding CadConfig.IsTextMode, Converter={StaticResource BoolToVis}}"
                                    Margin="0,0,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Room Name Layer:"
                                           VerticalAlignment="Center" Margin="0,0,8,6"/>
                                <ComboBox Grid.Row="0" Grid.Column="1"
                                          IsEditable="True" IsTextSearchEnabled="True"
                                          ItemsSource="{Binding CadConfig.AvailableLayers}"
                                          Text="{Binding CadConfig.RoomNameLayer, UpdateSourceTrigger=PropertyChanged}"
                                          DropDownOpened="OnDiscoveryDropDownOpened" Margin="0,0,0,6"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Ceiling Height Layer:"
                                           VerticalAlignment="Center" Margin="0,0,8,6"/>
                                <ComboBox Grid.Row="1" Grid.Column="1"
                                          IsEditable="True" IsTextSearchEnabled="True"
                                          ItemsSource="{Binding CadConfig.AvailableLayers}"
                                          Text="{Binding CadConfig.CeilingHeightLayer, UpdateSourceTrigger=PropertyChanged}"
                                          DropDownOpened="OnDiscoveryDropDownOpened" Margin="0,0,0,6"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Ceiling Height Block:"
                                           VerticalAlignment="Center" Margin="0,0,8,6"/>
                                <ComboBox Grid.Row="2" Grid.Column="1"
                                          IsEditable="True" IsTextSearchEnabled="True"
                                          ItemsSource="{Binding CadConfig.AvailableBlockNames}"
                                          Text="{Binding CadConfig.CeilingHeightBlockName, UpdateSourceTrigger=PropertyChanged}"
                                          DropDownOpened="OnDiscoveryDropDownOpened" Margin="0,0,0,6"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Ceiling Height Tag:"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Grid.Row="3" Grid.Column="1"
                                         Text="{Binding CadConfig.CeilingHeightBlockTag, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                            <TextBlock Text="Ceiling heights from text layer OR block attributes. Leave Ceiling Height Layer blank to use blocks only, or leave Block fields blank to use text only."
                                       Foreground="#888888" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- Region Generation Layers -->
                <GroupBox Header="Region Generation Layers (2D Workflow)" Margin="0,0,0,10" Padding="12,8"
                          Style="{StaticResource BoldHeaderGroupBox}">
                    <StackPanel Margin="4">
                        <TextBlock Text="CAD layer names used to auto-generate Room Region filled regions."
                                   Foreground="#555555" Margin="0,0,0,8" TextWrapping="Wrap"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Wall Layers:"
                                       VerticalAlignment="Center" Margin="0,0,8,6"/>
                            <TextBox Grid.Row="0" Grid.Column="1"
                                     Text="{Binding CadConfig.WallLayerNamesText, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Door Layers:"
                                       VerticalAlignment="Center" Margin="0,0,8,6"/>
                            <TextBox Grid.Row="1" Grid.Column="1"
                                     Text="{Binding CadConfig.DoorLayerNamesText, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Area Layers:"
                                       VerticalAlignment="Center" Margin="0,0,8,6"/>
                            <TextBox Grid.Row="2" Grid.Column="1"
                                     Text="{Binding CadConfig.AreaLayerNamesText, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Region Type Name:"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Grid.Row="3" Grid.Column="1"
                                     Text="{Binding CadConfig.RegionTypeName, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                        <TextBlock Text="Comma-separated CAD layer names (e.g., WALL_INTR_B, A-WALL)"
                                   Foreground="#888888" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </GroupBox>

                <!-- CAD settings above are dirty-tracked and auto-saved when the window closes. -->

                <!-- Generate Regions section (merged from the former standalone GenerateRegions window) -->
                <GroupBox Header="Generate Regions" Padding="12,8" Margin="0,0,0,12" Style="{StaticResource BoldHeaderGroupBox}">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="Draw Room Region filled regions interactively (Rectangle / Polygon), or Auto-generate them from the CAD room labels."/>

                        <!-- Result counts -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Created: " FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding CreatedCount}"/>
                            <TextBlock Text="  |  Failed: " FontWeight="SemiBold" Margin="4,0,0,0"/>
                            <TextBlock Text="{Binding FailedCount}"/>
                        </StackPanel>

                        <!-- Diagnostic status -->
                        <TextBlock Text="{Binding StatusText}" Foreground="#888888" FontSize="9.5"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="30"/>

                        <!-- Picking hint (visible while a pick loop is live) -->
                        <TextBlock Text="{Binding PickingHint}" Foreground="#555555" FontSize="11" Margin="0,4,0,0"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding IsPicking, Converter={StaticResource BoolToVis}}"/>

                        <!-- Action buttons (hidden while picking) -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPicking}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Button Content="Auto-generate" Width="100" Margin="0,0,8,0"
                                    Style="{StaticResource RevitButtonStyle}"
                                    Command="{Binding AutoGenerateCommand}"/>
                            <Button Content="Rectangle" Width="80" Margin="0,0,8,0"
                                    Style="{StaticResource RevitButtonStyle}"
                                    Command="{Binding RectangleCommand}"/>
                            <Button Content="Polygon" Width="80"
                                    Style="{StaticResource RevitButtonStyle}"
                                    Command="{Binding PolygonCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- Assign Room Names section -->
                <GroupBox Header="Assign Room Names" Padding="12,8" Style="{StaticResource BoldHeaderGroupBox}">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="Reads the linked DWG to extract room names and ceiling heights, assigns them to Room Region filled regions, and places TextNotes."/>
                        <Button Content="Run" Width="80" HorizontalAlignment="Right" Margin="0,8,0,0"
                                Style="{StaticResource RevitButtonStyle}"
                                Command="{Binding RunAssignCommand}"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- Close button -->
        <Button Grid.Row="1" Content="Close" Width="80" HorizontalAlignment="Right" Margin="0,12,0,0"
                Style="{StaticResource RevitButtonStyle}"
                Click="CloseButton_Click"/>
    </Grid>
</Window>
