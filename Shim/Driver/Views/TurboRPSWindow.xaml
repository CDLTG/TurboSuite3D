<Window
    x:Class="TurboSuite.Driver.Views.TurboRPSWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:TurboSuite.Driver.Views"
    Title="TurboRPS"
    Height="640" Width="1180"
    MinHeight="420" MinWidth="820"
    WindowStartupLocation="CenterScreen"
    FontFamily="Segoe UI" FontSize="11"
    KeyDown="Window_KeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TurboSuite;component/Shared/Styles/TurboSuiteStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Detail-pane converters -->
            <local:FeetInchesConverter x:Key="FeetInchesConverter"/>
            <local:SubDriverHeaderConverter x:Key="SubDriverHeaderConverter"/>
            <local:SegmentDisplayConverter x:Key="SegmentDisplayConverter"/>
            <local:NullToVisibilityConverter x:Key="NullToVisibility"/>
            <local:NotNullToVisibilityConverter x:Key="NotNullToVisibility"/>

            <!-- Status row-tint brushes. Escalating severity: amber STALE (fixable in place) →
                 light red REBUILD (needs a TurboDriver redeploy) → deeper red NO MATCH (no driver
                 fits at all). NEW is informational blue. Light red #FFDDDD matches TurboNumber's
                 error-row tint. -->
            <SolidColorBrush x:Key="StaleRowBrush" Color="#FFF3CD"/>
            <SolidColorBrush x:Key="RebuildRowBrush" Color="#FFDDDD"/>
            <SolidColorBrush x:Key="NewRowBrush" Color="#E3F0FB"/>
            <SolidColorBrush x:Key="NoMatchRowBrush" Color="#F5C2C7"/>

            <Style x:Key="TableHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="Padding" Value="6,3"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="TableCellStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="Padding" Value="6,3"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource ContentBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Blue header bar -->
        <Border Grid.Row="0" Background="{StaticResource HeaderBlueBrush}" Padding="15,10">
            <TextBlock Text="TurboRPS — Power Supply Review"
                       Foreground="White" FontSize="16" FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
        </Border>

        <!-- Toolbar -->
        <Border Grid.Row="1" Background="#F3F3F3"
                BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,0,0,1"
                Padding="8,6">
            <DockPanel>
                <Button Content="Re-run selected"
                        Command="{Binding ReRunSelectedCommand}"
                        Style="{StaticResource RevitButtonStyle}" Height="28" MinWidth="120"
                        DockPanel.Dock="Right"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Select all stale"
                            Command="{Binding SelectAllStaleCommand}"
                            Style="{StaticResource RevitButtonStyle}" Height="28"
                            Margin="0,0,8,0"/>
                    <CheckBox Content="Show only issues"
                              IsChecked="{Binding ShowOnlyIssues}"
                              VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Content="Rescan"
                            Command="{Binding RescanCommand}"
                            Style="{StaticResource RevitButtonStyle}" Height="28"
                            Margin="0,0,12,0"/>
                    <TextBlock Text="Circuit:" VerticalAlignment="Center" Margin="0,0,4,0"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBox Width="110" Height="24" VerticalContentAlignment="Center"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                             ToolTip="Live filter on circuit number"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Body: grid (left) + detail pane (right) -->
        <Grid Grid.Row="2" Margin="8,6,8,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="CircuitsGrid"
                      Grid.Column="0"
                      ItemsSource="{Binding RowsView}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{StaticResource SeparatorBrush}"
                      BorderThickness="1"
                      BorderBrush="{StaticResource SeparatorBrush}"
                      RowHeaderWidth="0"
                      IsReadOnly="True"
                      SelectionChanged="CircuitsGrid_SelectionChanged">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <!-- Always-present transparent left stripe so toggling the active
                             accent does not resize rows. -->
                        <Setter Property="BorderThickness" Value="4,0,0,0"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusText}" Value="STALE">
                                <Setter Property="Background" Value="{StaticResource StaleRowBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StatusText}" Value="REBUILD">
                                <Setter Property="Background" Value="{StaticResource RebuildRowBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StatusText}" Value="NEW">
                                <Setter Property="Background" Value="{StaticResource NewRowBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StatusText}" Value="NO MATCH">
                                <Setter Property="Background" Value="{StaticResource NoMatchRowBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsActiveRow}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource HeaderBlueBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <!-- Selection checkbox (enabled only on Stale rows) -->
                    <DataGridTemplateColumn Width="30" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding CanSelect}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="72"/>
                    <DataGridTextColumn Header="Circuit" Binding="{Binding CircuitNumber}" Width="60"/>
                    <DataGridTextColumn Header="Load Name" Binding="{Binding LoadName}" Width="150"/>
                    <DataGridTextColumn Header="Dimming" Binding="{Binding DimmingProtocol}" Width="70"/>
                    <DataGridTextColumn Header="Watts" Binding="{Binding RpsLoadWatts, StringFormat={}{0:F0}}" Width="55"/>
                    <DataGridTextColumn Header="Panel" Binding="{Binding Panel}" Width="60"/>
                    <DataGridTextColumn Header="Current" Binding="{Binding CurrentDisplay}" Width="120"/>
                    <DataGridTextColumn Header="Recommended" Binding="{Binding RecommendedDisplay}" Width="120"/>
                    <!-- Reason / hint ("→ TurboDriver" with cause, or re-split note) -->
                    <DataGridTextColumn Header="Note" Binding="{Binding ReasonNote}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                <Setter Property="FontStyle" Value="Italic"/>
                                <Setter Property="TextWrapping" Value="Wrap"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Detail pane (selected row) -->
            <Border Grid.Column="1" Margin="6,0,0,0"
                    BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="1"
                    Background="#FAFAFA">
                <Grid>
                    <!-- Placeholder when nothing selected -->
                    <TextBlock Text="Select a circuit to see its recommended packing"
                               VerticalAlignment="Center" HorizontalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap" Margin="16"
                               Foreground="{StaticResource TextSecondaryBrush}" FontStyle="Italic"
                               Visibility="{Binding SelectedRow, Converter={StaticResource NullToVisibility}}"/>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding SelectedRow}">
                        <StackPanel Margin="10"
                                    Visibility="{Binding DataContext.SelectedRow, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NotNullToVisibility}}">
                            <TextBlock Text="Recommended" FontWeight="Bold"
                                       Foreground="{StaticResource HeaderBlueBrush}"/>
                            <TextBlock Text="{Binding RecommendedHeader}" FontWeight="SemiBold"
                                       Margin="0,2,0,8" TextWrapping="Wrap"/>

                            <!-- Sub-driver packing -->
                            <ItemsControl ItemsSource="{Binding SubDriverAssignments}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,1,0,4">
                                            <TextBlock Text="{Binding Converter={StaticResource SubDriverHeaderConverter}}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <ItemsControl ItemsSource="{Binding Segments}" Margin="14,0,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Converter={StaticResource SegmentDisplayConverter}}"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Fixtures table -->
                            <TextBlock Text="Fixtures" FontWeight="Bold" Margin="0,8,0,2"
                                       Foreground="{StaticResource HeaderBlueBrush}"/>
                            <Grid Background="#E8E8E8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="Auto" MinWidth="46"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto" MinWidth="64"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Qty" Style="{StaticResource TableHeaderStyle}" TextAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Type" Style="{StaticResource TableHeaderStyle}"/>
                                <TextBlock Grid.Column="2" Text="Comments" Style="{StaticResource TableHeaderStyle}"/>
                                <TextBlock Grid.Column="3" Text="Length" Style="{StaticResource TableHeaderStyle}"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding GroupedFixtures}" AlternationCount="2">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="36"/>
                                                <ColumnDefinition Width="Auto" MinWidth="46"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto" MinWidth="64"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Quantity}" Style="{StaticResource TableCellStyle}" TextAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding TypeMark}" Style="{StaticResource TableCellStyle}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Comments}" Style="{StaticResource TableCellStyle}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="3" Text="{Binding LinearLength, Converter={StaticResource FeetInchesConverter}}" Style="{StaticResource TableCellStyle}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="3" Background="{StaticResource FooterBgBrush}"
                BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,1,0,0"
                Padding="8,6">
            <DockPanel>
                <Button Content="Close" Click="CloseButton_Click"
                        Style="{StaticResource RevitButtonStyle}" Height="28" Width="80"
                        DockPanel.Dock="Right"/>
                <Button Content="Select in Project"
                        Command="{Binding SelectInProjectCommand}"
                        Style="{StaticResource RevitButtonStyle}" Height="28"
                        DockPanel.Dock="Left" Margin="0,0,12,0"/>
                <TextBlock Text="{Binding CountsSummary}" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
