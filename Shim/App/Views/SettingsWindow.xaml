<Window
    x:Class="TurboSuite.App.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="TurboSuite Settings"
    Height="920" Width="500"
    MinHeight="520" MinWidth="400"
    WindowStartupLocation="CenterScreen"
    FontFamily="Segoe UI" FontSize="11">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TurboSuite;component/Shared/Styles/TurboSuiteStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="{StaticResource HeaderBlueBrush}" Padding="15,10">
            <DockPanel>
                <TextBlock Text="TurboSuite Settings" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock DockPanel.Dock="Right" Text="{Binding VersionText}" Foreground="#B0D0FF" FontSize="11"
                           VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource FooterBgBrush}"
                BorderBrush="#CCCCCC" BorderThickness="0,1,0,0" Padding="12,8">
            <Grid>
                <Button Content="Reset Defaults" HorizontalAlignment="Left"
                        Command="{Binding ResetDefaultsCommand}"
                        Style="{StaticResource RevitButtonStyle}"
                        Padding="12,5" MinWidth="100"/>
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Content="Save" Command="{Binding SaveCommand}"
                            Style="{StaticResource RevitButtonStyle}"
                            Padding="12,5" MinWidth="75" Margin="0,0,8,0"/>
                    <Button Content="Cancel" IsCancel="True"
                            Style="{StaticResource RevitButtonStyle}"
                            Padding="12,5" MinWidth="75"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,12">
            <StackPanel>
                <!-- General Settings -->
                <GroupBox Header="General" Margin="0,0,0,10" Style="{StaticResource BoldHeaderGroupBox}"
                          BorderBrush="#2B579A" BorderThickness="1.5">
                    <StackPanel Margin="4">
                        <CheckBox Content="Show circuit info dialog when creating circuits (TurboWire, TurboDriver)"
                                  IsChecked="{Binding ShowCircuitCommentsDialog}"
                                  VerticalContentAlignment="Center"
                                  Margin="0,0,0,4"/>
                        <CheckBox Content="Auto-split linear fixtures when TurboDriver splits segments (TurboDriver)"
                                  IsChecked="{Binding AutoSplitFixtures}"
                                  VerticalContentAlignment="Center"
                                  Margin="0,0,0,4"/>
                        <CheckBox Content="Enable dynamic driver tags (TurboBubble)"
                                  IsChecked="{Binding EnableDynamicDriverTags}"
                                  VerticalContentAlignment="Center"/>
                    </StackPanel>
                </GroupBox>

                <!-- CAD Room Source Settings -->
                <!-- CAD Room Source + Region Generation Layers moved to the TurboName window. -->


                <TextBlock Text="Configure which family names receive special routing behavior."
                           Foreground="#555555" Margin="0,0,0,12" TextWrapping="Wrap"/>

                <GroupBox Header="Wall Sconce Families" Margin="0,0,0,10" Style="{StaticResource BoldHeaderGroupBox}">
                    <StackPanel Margin="4">
                        <TextBlock Text="Families matched for wall sconce spline routing (one per line):"
                                   Foreground="#555555" Margin="0,0,0,4" TextWrapping="Wrap"/>
                        <TextBox Text="{Binding WallSconceFamiliesText, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" Height="95"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Receptacle Families" Margin="0,0,0,10" Style="{StaticResource BoldHeaderGroupBox}">
                    <StackPanel Margin="4">
                        <TextBlock Text="Families matched for receptacle spline routing (one per line):"
                                   Foreground="#555555" Margin="0,0,0,4" TextWrapping="Wrap"/>
                        <TextBox Text="{Binding ReceptacleFamiliesText, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" Height="95"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Vertical Families" Margin="0,0,0,10" Style="{StaticResource BoldHeaderGroupBox}">
                    <StackPanel Margin="4">
                        <TextBlock Text="Lighting fixture families treated as wall-mounted for tag placement (one per line):"
                                   Foreground="#555555" Margin="0,0,0,4" TextWrapping="Wrap"/>
                        <TextBox Text="{Binding VerticalFamiliesText, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" Height="95"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Switch Families" Margin="0,0,0,10" Style="{StaticResource BoldHeaderGroupBox}">
                    <StackPanel Margin="4">
                        <TextBlock Text="Families matched for switch wire endpoint offset (one per line):"
                                   Foreground="#555555" Margin="0,0,0,4" TextWrapping="Wrap"/>
                        <TextBox Text="{Binding SwitchFamiliesText, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" Height="95"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Equipment Box Families" Margin="0,0,0,10" Style="{StaticResource BoldHeaderGroupBox}">
                    <StackPanel Margin="4">
                        <TextBlock Text="Families matched for vertical (up/down) switchleg placement (one per line):"
                                   Foreground="#555555" Margin="0,0,0,4" TextWrapping="Wrap"/>
                        <TextBox Text="{Binding ElectricalVerticalFamiliesText, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" Height="95"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
