<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:TurboSuite.Shared.Converters">

    <!--
      TurboSuite shared style dictionary — merged by every windowed command, so a change here reaches all
      fifteen. There is no separate style guide document: the house rules live in this header, next to the
      styles they govern, because a sibling .md would drift the first time anyone edited this file.

      HOUSE RULES
      1. Squared corners. Buttons and button-like toggles use CornerRadius="0" — no rounded chrome anywhere
         (standing user preference). The CornerRadius="2"/"3"/"4" values in TurboRPS / TurboZones are on
         <Border>/<Expander> CARD chrome, not buttons; that's the only sanctioned exception.
      2. Templates must not hardcode what a Style setter can carry. If a control template pins a value the
         consumer might reasonably want to change — content alignment, foreground, cursor — TemplateBind it and
         set the default via a <Setter> in the same Style instead. A hardcoded template value silently beats the
         property on the control, so the consumer sets it, sees nothing happen, and has no way to tell why.
         This bit us once: RevitButtonStyle hardcoded HorizontalAlignment="Center" on its ContentPresenter, and
         TurboName's Line Graphics color row (a swatch + label that reads left) set HorizontalContentAlignment
         to no effect. Both button styles now TemplateBind both content alignments with Center as the setter
         default — same rendering as before, but overridable.
      3. Color comes from the brushes below, not from literals in a window. New window chrome should reach for
         an existing brush; add one here if none fits.
      4. This dictionary is shared, so a change is a cross-command change. Before editing a style used broadly
         (RevitButtonStyle, PrimaryButtonStyle, BoldHeaderGroupBox), confirm the change is behavior-preserving
         for consumers that never opted in — the pattern in rule 2 is how you do that.
    -->

    <!-- Converters -->
    <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    <converters:IntEqualConverter x:Key="IntEqualConverter"/>

    <!-- Core Brushes -->
    <SolidColorBrush x:Key="HeaderBlueBrush" Color="#2B579A"/>
    <SolidColorBrush x:Key="LinkBlueBrush" Color="#0066CC"/>
    <SolidColorBrush x:Key="ContentBgBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FooterBgBrush" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="#CCCCCC"/>
    <SolidColorBrush x:Key="ButtonBgBrush" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#ACACAC"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#555555"/>
    <SolidColorBrush x:Key="DisabledBgBrush" Color="#F0F0F0"/>

    <!-- Standard Button Style -->
    <Style x:Key="RevitButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource ButtonBgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ButtonBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="16,4"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Cursor" Value="Hand"/>
        <!-- Content alignment: default here, TemplateBound below (house rule 2) so a button can opt out. -->
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="0"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#DCECFC"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="#7EB4EA"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#C4E0FC"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="#569DE5"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Background" Value="#F5F5F5"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="#D9D9D9"/>
                            <Setter Property="Foreground" Value="#AAAAAA"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Primary Action Button Style (blue background, white text) -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource HeaderBlueBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="16,4"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <!-- Content alignment: default here, TemplateBound below (house rule 2) so a button can opt out. -->
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="0"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#3567B0"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#1E4478"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="#B0B0B0"/>
                <Setter Property="Foreground" Value="#E0E0E0"/>
                <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Hand cursor for interactive controls (content areas inherit Arrow) -->
    <Style TargetType="ComboBox">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style TargetType="DatePicker">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style TargetType="TabItem">
        <Setter Property="Cursor" Value="Arrow"/>
        <Setter Property="HeaderTemplate">
            <Setter.Value>
                <DataTemplate>
                    <ContentPresenter Content="{Binding}" Cursor="Hand"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="GroupBox">
        <Setter Property="Cursor" Value="Arrow"/>
    </Style>
    <!-- SemiBold-header GroupBox (matches TurboDMX's section headers). Keyed, not implicit, so
         GroupBoxes with custom element headers (context menus, dropdown buttons) are unaffected.
         Apply only to boxes whose Header is a plain string. -->
    <Style x:Key="BoldHeaderGroupBox" TargetType="GroupBox" BasedOn="{StaticResource {x:Type GroupBox}}">
        <Setter Property="HeaderTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Sortable DataGrid: apply to grids with column sorting enabled -->
    <Style x:Key="SortableDataGridStyle" TargetType="DataGrid">
        <Setter Property="Cursor" Value="Arrow"/>
    </Style>
    <Style x:Key="SortableColumnHeaderStyle" TargetType="DataGridColumnHeader">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

</ResourceDictionary>
