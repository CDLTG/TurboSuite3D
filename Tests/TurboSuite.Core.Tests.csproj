<Project Sdk="Microsoft.NET.Sdk">
  <!-- Automated oracle suites for the pure, Revit-free logic in Core/ (and Abstractions/).
       References Core ONLY — no Revit/shim refs — so it covers anything testable without Revit:
       the Core/Dmx/ engine (packing, addressing, wire numbering) and the Core/Driver/
       StaleClassifier, with more added as pure Core logic lands. (Revit-coupled shim code is
       validated by manual in-Revit testing instead.) net8.0-windows matches Core's net8 TFM so the
       multi-targeted Core reference resolves without a platform-compat warning; the logic under
       test is identical across Core's net48 and net8 builds. -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>TurboSuite.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\TurboSuite.Core.csproj" />
  </ItemGroup>
</Project>
